{
  "name": "flowfoods-portal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "gate": "node scripts/gate-conteudo.mjs",
    "ajuda:lock": "tsx scripts/ajuda-lock.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "NODE_OPTIONS=--max-old-space-size=6144 tsc --noEmit",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:push": "prisma db push",
    "worker": "tsx worker/index.ts",
    "worker:estado": "tsx worker/index.ts --estado",
    "erp:seed-teste": "tsx scripts/erp-seed-teste.ts",
    "erp:conferir-migracao": "tsx scripts/erp-conferir-migracao.ts",
    "erp:semear-categorias": "tsx scripts/erp-semear-categorias.ts",
    "erp:classificar-insumos": "tsx scripts/erp-classificar-insumos.ts",
    "integracao:conferir": "tsx scripts/integracao-conferir.ts",
    "integracao:ler-test": "tsx scripts/integracao-ler-test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "@prisma/client": "^6.19.3",
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.3",
    "bcryptjs": "^3.0.3",
    "fast-xml-parser": "5.11.2",
    "lucide-react": "0.460.0",
    "luxon": "^3.7.2",
    "next": "^14",
    "next-auth": "^4.24.15",
    "react": "^18",
    "react-dom": "^18",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/luxon": "^3.7.5",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10",
    "eslint": "^8",
    "eslint-config-next": "^14",
    "postcss": "^8",
    "prisma": "^6.19.3",
    "tailwindcss": "^3",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
