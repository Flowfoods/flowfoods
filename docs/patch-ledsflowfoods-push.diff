+# ------------------------------------------------------------------------- push
+def enviar_para_portal(leads, rotulo, url, somente_celular):
+    """Manda o lote para o portal. Devolve o resumo da importacao.
+
+    O portal e quem decide o que entra: conflito com o Bibi, opt-out antigo e
+    telefone invalido sao barrados LA, nao aqui. Este script so entrega.
+    """
+    token = os.environ.get("FLOWFOODS_IMPORT_TOKEN", "").strip()
+    if not token:
+        sys.exit(
+            "Falta FLOWFOODS_IMPORT_TOKEN no ambiente.\n"
+            "  export FLOWFOODS_IMPORT_TOKEN=<LEADS_IMPORT_TOKEN do Dokploy>\n"
+            "Nunca passe o token como argumento: ele apareceria em `ps` e no historico."
+        )
+
+    # So as colunas da planilha. As chaves internas (msg, msgig, num, curto) sao
+    # do app HTML e nao interessam ao portal.
+    linhas = [{c: l.get(c, "") for c in COLS} for l in leads]
+    corpo = json.dumps(
+        {"lote": rotulo, "somenteCelular": bool(somente_celular), "linhas": linhas}
+    ).encode("utf-8")
+
+    req = urllib.request.Request(
+        url.rstrip("/") + "/api/leads/import",
+        data=corpo,
+        method="POST",
+        headers={"Content-Type": "application/json", "x-import-token": token},
+    )
+
+    try:
+        with urllib.request.urlopen(req, timeout=120) as r:
+            return json.loads(r.read().decode("utf-8"))
+    except urllib.error.HTTPError as e:
+        detalhe = e.read().decode("utf-8", "replace")[:400]
+        if e.code == 401:
+            sys.exit("Token recusado (401). Confira o LEADS_IMPORT_TOKEN no Dokploy.")
+        sys.exit(f"O portal recusou o lote (HTTP {e.code}): {detalhe}")
+    except urllib.error.URLError as e:
+        sys.exit(f"Nao consegui falar com o portal: {e.reason}")
+
+
