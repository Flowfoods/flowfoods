# Espaco do Rodolfo + Barney — variaveis.
# Em producao TODAS vivem no Dokploy. Este arquivo e so referencia: nunca
# comite um .env preenchido.

# --- Banco ---------------------------------------------------------------
DATABASE_URL="postgresql://usuario:senha@host:5432/flowfoods?schema=public"

# --- Sessao --------------------------------------------------------------
# openssl rand -hex 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="https://consultoriaflowfoods.com.br"

# Token do PRIMEIRO ACESSO: /rodolfo/setup?token=...
# Usado uma vez, para voce definir a senha. openssl rand -hex 32
ADMIN_SETUP_TOKEN=""

# Token do POST /api/leads/import, usado pelo --push do ledsflowfoods.
# SEPARADO do de cima de proposito: este viaja em script de terminal e acaba
# em historico de shell. Se ficar vazio, o ADMIN_SETUP_TOKEN e aceito como
# fallback — mas separe assim que puder. openssl rand -hex 32
LEADS_IMPORT_TOKEN=""

# --- Evolution API (WhatsApp) --------------------------------------------
# Ausentes: o portal entra em dry-run e nao envia nada.
EVOLUTION_API_URL=""
EVOLUTION_API_KEY=""
EVOLUTION_INSTANCE="flowfoods-prospeccao"

# Instancia separada so para as notificacoes ao Rodolfo. Vazio = usa a de cima.
EVOLUTION_NOTIFY_INSTANCE=""

# openssl rand -hex 32 — o webhook recusa 401 sem isto.
EVOLUTION_WEBHOOK_SECRET=""

# Numero que recebe as notificacoes, em E.164 sem "+": 5521999998888
RODOLFO_WHATSAPP=""

# --- IA (opcional) -------------------------------------------------------
# Ausente: o Inbox funciona sem classificacao e sem rascunho.
ANTHROPIC_API_KEY=""
# Teto de gasto diario em reais. Vazio ou 0 = sem teto.
AI_DAILY_BUDGET_BRL="5"
# Cambio usado para converter o custo da API (USD) para o teto em BRL.
USD_BRL="5.40"

# --- Portal do cliente ---------------------------------------------------
# Pasta dos arquivos enviados pelo formulario. No compose ja vem /data/portal,
# montada no volume portal-uploads.
PORTAL_UPLOAD_DIR="/data/portal"

# --- ERP do parceiro: "entrar com o rosto" (opcional) ---------------------
# Vazias = o mesmo endereco do NEXTAUTH_URL. O rosto (passkey) so funciona em
# https ou no localhost, e fica preso ao dominio (RP ID).
ERP_WEBAUTHN_ORIGIN=""
ERP_WEBAUTHN_RP_ID=""

# ------------------------------------------------------------------ Central de Integrações (INT-1.2)
# Desligada por padrão: só "true" liga a integração do iFood.
INTEGRACAO_IFOOD_ATIVA=false
# 64 caracteres hexadecimais (32 bytes). Em produção o serviço "segredos" do compose gera; local: openssl rand -hex 32
INTEGRACAO_CHAVE_CIFRAGEM=
# Endereço da API (só https e domínio do iFood). Vazio = o oficial.
IFOOD_API_BASE=https://merchant-api.ifood.com.br
# Segredos dos apps no iFood: SÓ no painel do Dokploy, nunca no Git. O Client ID fica no cadastro do app (Central).
IFOOD_TEST_CLIENT_SECRET=
IFOOD_BI_CLIENT_SECRET=
