// Schema do portal FlowFoods — Caminho 3 (Barney).
//
// Migrations são SÓ ADITIVAS. Nada de DROP, remoção ou renomeação de coluna,
// nem `migrate reset`: isso é parada de segurança do Master Prompt.
//
// Os modelos compartilhados (User, Lead, Message, OptOut, Setting, AuditLog,
// WebEvent) seguem o contrato comum dos 3 caminhos. Os campos marcados
// "C3" são as adições deste caminho; se o Caminho 1 ou 2 já tiver criado o
// modelo, este arquivo só acrescenta.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------------ admin

enum Role {
  ADMIN
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  senhaHash    String?
  role         Role      @default(ADMIN)
  criadoEm     DateTime  @default(now())
  ultimoLogin  DateTime?
  auditorias   AuditLog[]
}

// ------------------------------------------------------------------- lead

enum LeadSource {
  SITE
  LEDS_IMPORT
  MANUAL
  BARNEY
  INDICACAO
}

enum Interesse {
  CONSULTORIA
  MENTORIA
  CURSO
  CONTEUDO
}

enum LeadStatus {
  NOVO
  EM_CADENCIA
  RESPONDEU
  DIAGNOSTICO_PREENCHIDO
  DIAGNOSTICO_AGENDADO
  DIAGNOSTICO_FEITO
  PROPOSTA
  CLIENTE
  PERDIDO
  OPT_OUT
  CONFLITO
}

enum TipoTelefone {
  CELULAR
  FIXO
  INVALIDO
}

enum Canal {
  WHATSAPP
  INSTAGRAM
  VISITA
}

enum Tier {
  T1
  T2
  T3
}

model Lead {
  id                   String       @id @default(cuid())
  nome                 String
  restaurante          String?
  telefoneNormalizado  String?      // E.164 sem "+": 5521999998888
  tipoTelefone         TipoTelefone @default(INVALIDO)
  telefoneOriginal     String?      // o que veio na planilha, para auditoria
  categoria            String?
  bairro               String?
  bloco                String?
  source               LeadSource   @default(LEDS_IMPORT)
  interesse            Interesse?
  status               LeadStatus   @default(NOVO)
  flags                String[]     @default([])
  utm                  Json?

  // C3 — dados da planilha do ledsflowfoods
  endereco             String?
  nota                 Float?
  avaliacoes           Int?
  obs                  String?

  // C3 — enriquecimento (2ª passada, manual)
  instagram            String?
  ifoodUrl             String?
  donoNome             String?

  // C3 — scoring
  scoreBase            Int?         // 0–70
  capacidade           Int?         // 0–35
  acessoDecisor        Int?         // 0–20
  territorio           Int?         // 0–15
  gapDigital           Int?         // 0–30, null enquanto não apurado
  scoreTotal           Int?         // 0–100, null enquanto gapDigital for null
  tier                 Tier?

  canal                Canal        @default(VISITA)
  lote                 String?
  importadoEm          DateTime?
  criadoEm             DateTime     @default(now())
  atualizadoEm         DateTime     @updatedAt

  eventos              LeadEvent[]
  mensagens            Message[]
  enrollments          Enrollment[]
  itensLote            BatchItem[]

  // Dedup de reimportação. Parcial no Postgres (só onde não é null) via
  // migration — Prisma não expressa índice parcial no schema.
  @@unique([telefoneNormalizado])
  @@index([status])
  @@index([tier])
  @@index([bloco, bairro])
  @@index([canal])
  @@index([lote])
}

model LeadEvent {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  tipo      String   // import, score, envio, entrega, leitura, resposta, classificacao, status, nota, exclusao
  descricao String
  dados     Json?
  criadoEm  DateTime @default(now())

  @@index([leadId, criadoEm])
  @@index([tipo])
}

// Opt-out sobrevive a reimportação: a chave é o telefone, não o lead. Apagar o
// lead e reimportar NÃO devolve a pessoa para a fila.
model OptOut {
  id                  String   @id @default(cuid())
  telefoneNormalizado String   @unique
  termo               String?  // a palavra que casou, para auditoria
  origem              String   @default("RESPOSTA")
  criadoEm            DateTime @default(now())
}

// --------------------------------------------------------------- templates

enum Toque {
  D0
  D4
  D10
}

enum CanalTemplate {
  WHATSAPP
  INSTAGRAM
}

model Template {
  id          String        @id @default(cuid())
  categoria   String?       // null = template padrão
  toque       Toque
  canal       CanalTemplate @default(WHATSAPP)
  variante    String        @default("A")
  corpo       String
  ativo       Boolean       @default(true)
  validadoEm  DateTime?
  criadoEm    DateTime      @default(now())
  atualizadoEm DateTime     @updatedAt

  mensagens   Message[]

  @@unique([categoria, toque, canal, variante])
  @@index([ativo, toque])
}

model Sequence {
  id          String         @id @default(cuid())
  nome        String         @unique
  ativa       Boolean        @default(true)
  criadoEm    DateTime       @default(now())
  steps       SequenceStep[]
  enrollments Enrollment[]
}

model SequenceStep {
  id          String   @id @default(cuid())
  sequenceId  String
  sequence    Sequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  toque       Toque
  offsetDias  Int
  ordem       Int

  @@unique([sequenceId, toque])
  @@index([sequenceId, ordem])
}

enum EnrollmentStatus {
  ATIVA
  PAUSADA_RESPOSTA
  PAUSADA_MANUAL
  CONCLUIDA
  OPT_OUT
}

model Enrollment {
  id             String           @id @default(cuid())
  leadId         String
  lead           Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  sequenceId     String
  sequence       Sequence         @relation(fields: [sequenceId], references: [id])
  status         EnrollmentStatus @default(ATIVA)
  toqueAtual     Toque?
  proximoEnvioEm DateTime?
  pausadoEm      DateTime?
  motivoPausa    String?
  criadoEm       DateTime         @default(now())

  mensagens      Message[]

  // Um lead não fica em duas cadências da mesma sequência ao mesmo tempo.
  @@unique([leadId, sequenceId])
  @@index([status, proximoEnvioEm])
  @@index([proximoEnvioEm])
}

// ----------------------------------------------------------------- outbox

enum Direction {
  IN
  OUT
}

enum MessageStatus {
  PENDENTE
  AGENDADA
  ENVIADA
  ENTREGUE
  LIDA
  FALHA
  RECUSADA
}

model Message {
  id                 String        @id @default(cuid())
  direction          Direction
  kind               String        // CADENCIA | RESPOSTA_MANUAL | NOTIFICACAO | ...
  status             MessageStatus @default(PENDENTE)

  // A unicidade do dedup mora AQUI, no banco. Worker reiniciado no meio de um
  // lote e duplo clique em "Aprovar" batem na constraint, não na boa vontade
  // do código.
  dedupKey           String        @unique
  evolutionMessageId String?       @unique

  to                 String?
  corpoRenderizado   String?
  erro               String?
  tentativas         Int           @default(0)

  agendadaPara       DateTime?
  enviadaEm          DateTime?
  entregueEm         DateTime?
  lidaEm             DateTime?
  criadoEm           DateTime      @default(now())

  leadId             String?
  lead               Lead?         @relation(fields: [leadId], references: [id], onDelete: SetNull)
  enrollmentId       String?
  enrollment         Enrollment?   @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)
  templateId         String?
  template           Template?     @relation(fields: [templateId], references: [id], onDelete: SetNull)
  loteId             String?
  lote               Batch?        @relation(fields: [loteId], references: [id], onDelete: SetNull)
  toque              Toque?

  classificacao      InboundClassification?

  @@index([status, agendadaPara])
  @@index([leadId, criadoEm])
  @@index([loteId])
  @@index([direction, criadoEm])
}

// ------------------------------------------------------------------- lote

enum BatchStatus {
  PROPOSTO
  APROVADO
  EM_ENVIO
  CONCLUIDO
  CANCELADO
}

model Batch {
  id         String      @id @default(cuid())
  data       DateTime    @db.Date
  status     BatchStatus @default(PROPOSTO)
  aprovadoEm DateTime?
  aprovadoPor String?
  criadoEm   DateTime    @default(now())

  itens      BatchItem[]
  mensagens  Message[]

  // Um lote por dia. O segundo "propor lote" do mesmo dia atualiza, não duplica.
  @@unique([data])
  @@index([status])
}

model BatchItem {
  id       String   @id @default(cuid())
  batchId  String
  batch    Batch    @relation(fields: [batchId], references: [id], onDelete: Cascade)
  leadId   String
  lead     Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  toque    Toque
  ordem    Int

  @@unique([batchId, leadId])
  @@index([batchId, ordem])
}

// -------------------------------------------------------------- inbox / IA

enum Intencao {
  INTERESSADO
  PERGUNTA
  DEPOIS
  RECUSA
  OPT_OUT
  OUTRO
}

model InboundClassification {
  id               String   @id @default(cuid())
  messageId        String   @unique
  message          Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  intencao         Intencao
  confianca        Float
  rascunhoSugerido String?
  custoIA          Decimal? @db.Decimal(10, 6)
  modelo           String?
  criadoEm         DateTime @default(now())

  @@index([intencao])
}

// ------------------------------------------------------ contadores e estado

// Base dos tetos. A data é o dia em America/Sao_Paulo — gravada já convertida,
// nunca derivada de now() em UTC.
model DailyCounter {
  id            String   @id @default(cuid())
  data          DateTime @db.Date
  instancia     String
  enviados      Int      @default(0)
  entregues     Int      @default(0)
  falhas        Int      @default(0)
  ultimoEnvioEm DateTime?

  @@unique([data, instancia])
  @@index([instancia, data])
}

model InstanceState {
  id              String    @id @default(cuid())
  nome            String    @unique
  estado          String    @default("close")
  ultimoCheck     DateTime?
  // Início da rampa. É o PRIMEIRO ENVIO, não a criação da instância: número
  // criado e esquecido por um mês não está aquecido, está parado.
  primeiroEnvioEm DateTime?
  // Número pareado nesta instância (E.164 sem "+"), lido do `ownerJid` da
  // Evolution. Serve para uma coisa: saber se o número que PROSPECTA é o mesmo
  // que RECEBE as notificações. Quando é — o caso de usar o telefone pessoal —
  // notificar vira mandar mensagem para si mesmo: inútil, porque a resposta já
  // chega no aparelho, e gasta atividade do número à toa.
  numeroProprio   String?
  atualizadoEm    DateTime  @updatedAt
}

// ------------------------------------------------------------ infra comum

model Setting {
  chave        String   @id
  valor        Json
  atualizadoEm DateTime @updatedAt
}

model AuditLog {
  id       String   @id @default(cuid())
  userId   String?
  user     User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  evento   String
  dados    Json?
  ip       String?
  criadoEm DateTime @default(now())

  @@index([evento, criadoEm])
  @@index([criadoEm])
}

model WebEvent {
  id          String   @id @default(cuid())
  pagina      String
  evento      String
  origem      String?
  utm         Json?
  referrer    String?
  sessionHash String?
  ts          DateTime @default(now())

  @@index([pagina, ts])
  @@index([evento, ts])
}

// ----------------------------------------------------------- portal cliente
//
// Formulário inicial de cada cliente da consultoria, em
// /portal/<token>. O CONTEÚDO (itens, perguntas, textos) não mora no banco:
// vem de `src/lib/portal/questionarios/<questionario>.json`, versionado e
// fechado com o consultor. O banco guarda só quem é o cliente e o que ele
// respondeu.

enum PortalMarcacao {
  NAO_TENHO
  NAO_SEI
  AGORA_NAO
}

model PortalCliente {
  id                String           @id @default(cuid())
  nome              String
  slug              String           @unique
  // O código do link. Aleatório e longo: quem não recebeu o link não adivinha.
  token             String           @unique
  // Chave do JSON em src/lib/portal/questionarios.
  questionario      String
  finalizadoEm      DateTime?
  ultimaAtividadeEm DateTime?
  avisoEnviadoEm    DateTime?
  avisoErro         String?
  criadoEm          DateTime         @default(now())

  respostas         PortalResposta[]
  arquivos          PortalArquivo[]
}

model PortalResposta {
  id           String          @id @default(cuid())
  clienteId    String
  cliente      PortalCliente   @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  itemId       String
  texto        String?
  marcacao     PortalMarcacao?
  criadoEm     DateTime        @default(now())
  atualizadoEm DateTime        @updatedAt

  // Uma linha por item: o autosave atualiza, não empilha.
  @@unique([clienteId, itemId])
}

model PortalArquivo {
  id           String        @id @default(cuid())
  clienteId    String
  cliente      PortalCliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  itemId       String
  bloco        String
  nomeOriginal String
  // Caminho absoluto no disco do container (volume portal-uploads).
  caminho      String
  tamanho      Int
  mime         String?
  criadoEm     DateTime      @default(now())

  @@index([clienteId, itemId])
}

// ---------------------------------------------------------------- ERP Barney
//
// FlowFoods Barney — ERP multi-tenant. Plano e ordem das fases: página
// "FlowFoods Barney — ERP" no Notion (fonte única da verdade).
//
// Duas regras que valem para TODA tabela deste bloco, agora e nas próximas fases:
//
// 1. Multi-tenant: toda linha pertence a um ParceiroFlow (`parceiroId`). Nenhum
//    código lê ou grava esses modelos pelo `prisma` cru: passa por
//    `doParceiro()` em `src/lib/erp/tenant.ts`, que amarra o parceiro em toda
//    query. Há teste que reprova o uso direto.
// 2. Inteiros sempre: quantidade em MILÉSIMOS da unidade base (1 kg = 1000,
//    1 L = 1000, 1 un = 1000) e dinheiro em CENTAVOS. Nada de float, nada de
//    Decimal — arredondamento acontece num lugar só (`src/lib/erp/unidades.ts`).
// 3. Percentual em PONTOS-BASE (1% = 100, 100% = 10000). Fator (correção,
//    rendimento) em MILÉSIMOS (1,000 = 1000; FC 1,18 = 1180).
// 4. Tenant também nas chaves estrangeiras: toda referência entre tabelas de
//    tenant é FK COMPOSTA (parceiroId, xId) → (parceiroId, id). O banco recusa
//    uma ficha de B apontando para insumo de A, mesmo que o código erre. Por
//    isso toda tabela referenciada tem `@@unique([parceiroId, id])`, e toda FK
//    composta é Restrict/Cascade, nunca SetNull (anularia o parceiroId). E um
//    trigger em toda tabela de tenant recusa UPDATE que troque o parceiroId.
//    E RLS (0.2): toda tabela de tenant tem RLS forçada + política para o papel
//    `erp_tenant`. Tabela nova de tenant: a migration precisa do GRANT, do
//    ENABLE/FORCE ROW LEVEL SECURITY e da política (tests/erp-rls.db.test.ts).
// 5. Snapshot: documento que registra um fato (item de nota, movimento,
//    contagem, produção, etiqueta) grava nome/unidade/valor daquele momento.
//    Renomear o insumo amanhã não reescreve o passado.
// 6. Nada acumulado é gravado: total do mês, DRE, CMV e lista do dia são
//    somas/derivações na hora. Por isso `Int` (até R$ 21 mi por linha) basta e
//    não há `BigInt` no ERP.

enum ParceiroStatus {
  // Lead que entrou pela landing e espera o Rodolfo liberar (fase 0.5).
  RASCUNHO
  ATIVO
  SUSPENSO
}

// Como o parceiro fecha o período do DRE (2.2). Os períodos em si ficam em
// PeriodoApuracao e a regra, versionada, em RegraDoPeriodo. PERSONALIZADO é
// legado: não tem tela e a regra nova nunca o aceita.
enum PeriodoTipo {
  MENSAL
  QUINZENAL
  SEMANAL
  PERSONALIZADO
}

model ParceiroFlow {
  id               String         @id @default(cuid())
  nome             String
  slug             String         @unique
  status           ParceiroStatus @default(RASCUNHO)
  criadoEm         DateTime       @default(now())
  // 2.2a: SEM USO. A regra do período mora em `RegraDoPeriodo` (a migration copiou
  // estes dois valores para a primeira linha). As colunas ficam só porque migration
  // aditiva não apaga coluna; nada as lê nem as grava.
  periodoTipo      PeriodoTipo    @default(MENSAL)
  periodoDiaInicio Int            @default(1)

  // Relações de tenant: nunca acessadas pelo prisma cru (RELACOES_DE_TENANT).
  // Prefixo `erp` nas novas: nome único, o teste-guarda não confunde com
  // campos homônimos do Diagnóstico (`lojas`, `fichasTecnicas`).
  insumos                Insumo[]
  erpLojas               Loja[]
  erpMarcas              Marca[]
  erpColaboradores       Colaborador[]
  erpFornecedores        Fornecedor[]
  erpInsumoVariantes     InsumoVariante[]
  erpFichasTecnicas      FichaTecnica[]
  erpFichaItens          FichaItem[]
  erpProdutosVenda       ProdutoVenda[]
  erpProdutoCanais       ProdutoCanal[]
  erpProdutoEmbalagens   ProdutoEmbalagem[]
  erpCanaisConfig        CanalConfig[]
  erpNotasEntrada        NotaEntrada[]
  erpNotaEntradaItens    NotaEntradaItem[]
  erpSaldosEstoque       SaldoEstoque[]
  erpMovimentosEstoque   MovimentoEstoque[]
  erpContagens           Contagem[]
  erpContagemItens       ContagemItem[]
  erpRequisicoes         Requisicao[]
  erpRequisicaoItens     RequisicaoItem[]
  erpOrdensProducao      OrdemProducao[]
  erpListasProducao      ListaProducao[]
  erpListaProducaoItens  ListaProducaoItem[]
  erpCategoriasInsumo    CategoriaInsumo[]
  erpCategoriasNaLoja    CategoriaNaLoja[]
  erpMetasCmvConjuntos   MetaCmvConjunto[]
  erpMetasCmvCategorias  MetaCmvCategoria[]
  erpContagemRetratoItens ContagemRetratoItem[]
  erpEtiquetas           Etiqueta[]
  erpFaturamentos        FaturamentoLancamento[]
  erpDreLinhas           DreLinha[]
  erpDreMetas            DreMeta[]
  erpDespesas            Despesa[]
  erpPeriodosApuracao    PeriodoApuracao[]
  erpRegrasDoPeriodo     RegraDoPeriodo[]
  erpDreFotografias      DreFotografia[]
  erpDreFotografiaLinhas DreFotografiaLinha[]
  erpFarolFaixas         FarolFaixa[]
  erpHistoricoAlteracoes HistoricoAlteracao[]

  // Acesso das pessoas (0.3): FORA do tenant, só por `src/lib/erp/credenciais.ts`
  // (RELACOES_DE_CREDENCIAL; o prisma do portal recusa).
  erpAcessos             AcessoParceiro[]
  erpConvites            ConviteAcesso[]
  erpSessoes             SessaoErp[]
  // Perfis próprios do parceiro (0.4): mesma trava das credenciais.
  erpPerfis              PerfilAcesso[]
  // Pedido que originou este parceiro (0.5): FORA do tenant, só por
  // `pedidos.ts` e `credenciais.ts` (RELACOES_DE_PEDIDO; o prisma do portal recusa).
  erpPedidoDeOrigem      PedidoParceiro?        @relation("PedidoParceiroCriado")
}

// ------------------------------------------------- ERP · comuns

enum UnidadeBase {
  KG
  L
  UN
}

// De onde veio a linha: digitada, planilha importada ou integração (iFood etc.).
// Importação manual sempre ao lado da integração.
enum OrigemDado {
  MANUAL
  IMPORTACAO
  INTEGRACAO
}

enum CanalVenda {
  LOJA // salão/balcão: custo = insumos
  DELIVERY_PROPRIO // + embalagem
  IFOOD // + embalagem + taxa do canal
}

enum Conservacao {
  SECO // seco / ambiente
  PISTA_FRIA
  REFRIGERADO
  CONGELADO
}

// ------------------------------------------------- ERP · estrutura (N2 → N3)

// N3: a loja/unidade, onde a operação acontece. Pertence a um parceiro (N2).
model Loja {
  id         String       @id @default(cuid())
  parceiroId String
  parceiro   ParceiroFlow @relation(fields: [parceiroId], references: [id], onDelete: Restrict)
  nome       String
  slug       String
  ativa      Boolean      @default(true)
  criadoEm   DateTime     @default(now())

  // F.1a: o CNPJ da loja (14 dígitos, dígitos verificadores conferidos pela regra), o destinatário das notas fiscais de compra.
  // Opcional e NÃO único: duas lojas podem operar no mesmo CNPJ (a conferência da F.1b pede a loja). Muda com `lojas.gerir`.
  cnpj       String?

  // 1.7: regras da contagem desta loja (mudam só com "cadastrar lojas", rede
  // inteira: o gerente não baixa o piso que o trava). Piso do fechamento do
  // período: cobertura mínima por valor e por itens, em pontos-base (CHECK
  // 5000..10000 e 0..10000). Frequência por classe da curva ABC, em dias
  // (CHECK 1..90, A <= B <= C). Tolerância por item para a contagem fechar
  // sozinha, em centavos (0 = só se bater exato; CHECK 0..100000).
  contagemPisoValorBp        Int @default(8000)
  contagemPisoItensBp        Int @default(5000)
  contagemFreqADias          Int @default(7)
  contagemFreqBDias          Int @default(15)
  contagemFreqCDias          Int @default(30)
  contagemToleranciaCentavos Int @default(500)

  // 2.1: em quais canais esta loja vende (CHECK: pelo menos um). A unidade só
  // delivery desliga a LOJA; sem isso o calendário acusaria falta de salão todo
  // dia. Muda com "cadastrar lojas" (rede inteira), com antes/depois no histórico.
  canaisDeVenda CanalVenda[] @default([LOJA, DELIVERY_PROPRIO, IFOOD])

  colaboradores  Colaborador[]
  notasEntrada   NotaEntrada[]
  saldos         SaldoEstoque[]
  movimentos     MovimentoEstoque[]
  contagens      Contagem[]
  requisicoes    Requisicao[]
  ordensProducao OrdemProducao[]
  listasProducao ListaProducao[]
  etiquetas      Etiqueta[]
  faturamentos   FaturamentoLancamento[]
  despesas       Despesa[]
  fotografiasDoDre DreFotografiaLinha[]
  categoriasNaLoja CategoriaNaLoja[]
  conjuntosDeMetaCmv MetaCmvConjunto[]

  @@unique([parceiroId, id])
  @@unique([parceiroId, slug])
  @@unique([parceiroId, nome])
}

// Marca do grupo (ex.: Valentin's Burger, Valentin's Gourmet). Uma loja pode
// operar várias marcas; o vínculo aparece no faturamento (loja × marca × canal).
model Marca {
  id         String       @id @default(cuid())
  parceiroId String
  parceiro   ParceiroFlow @relation(fields: [parceiroId], references: [id], onDelete: Restrict)
  nome       String
  ativa      Boolean      @default(true)
  criadoEm   DateTime     @default(now())

  produtos     ProdutoVenda[]
  faturamentos FaturamentoLancamento[]

  @@unique([parceiroId, id])
  @@unique([parceiroId, nome])
}

// Pessoa da operação: âncora do histórico de produção, contagem e requisição
// por funcionário. Login e permissões (0.3/0.4) se penduram aqui depois.
model Colaborador {
  id         String       @id @default(cuid())
  parceiroId String
  parceiro   ParceiroFlow @relation(fields: [parceiroId], references: [id], onDelete: Restrict)
  lojaId     String?
  loja       Loja?        @relation(fields: [parceiroId, lojaId], references: [parceiroId, id], onDelete: Restrict)
  nome       String
  ativo      Boolean      @default(true)
  criadoEm   DateTime     @default(now())

  movimentos          MovimentoEstoque[]
  contagemItens       ContagemItem[]
  requisicoesFeitas   Requisicao[]         @relation("RequisicaoSolicitante")
  requisicoesAtendida Requisicao[]         @relation("RequisicaoAtendente")
  producoes           OrdemProducao[]
  etiquetas           Etiqueta[]
  alteracoes          HistoricoAlteracao[]

  @@unique([parceiroId, id])
  @@index([parceiroId, lojaId])
}

// ------------------------------------------------- ERP · insumos e compras

model Fornecedor {
  id         String       @id @default(cuid())
  parceiroId String
  parceiro   ParceiroFlow @relation(fields: [parceiroId], references: [id], onDelete: Restrict)
  // F.1a: o nome fantasia, como a casa chama (continua único no parceiro); a razão social é coluna própria.
  nome       String
  // CNPJ/CPF só dígitos; opcional porque feira e atacarejo nem sempre têm. F.1a: único por parceiro (índice parcial só no SQL:
  // `Fornecedor_parceiroId_documento_key`, onde o documento não é nulo); a filial tem outro CNPJ e é outro cadastro.
  documento  String?
  // Texto livre do cadastro antigo (1.5). Só leitura a partir da F.1a: nada é convertido em WhatsApp ou e-mail por palpite.
  contato    String?
  ativo      Boolean      @default(true)
  criadoEm   DateTime     @default(now())
  // 1.5: edição condicional à versão lida (duas abas não se atropelam).
  atualizadoEm DateTime   @default(now()) @updatedAt

  // F.1a — cadastro evoluído (preparado para o documento fiscal da F.1b). Tudo opcional no banco; o que é obrigatório quem exige é
  // a regra (formulário e servidor), conforme `semNotaFiscal`.
  razaoSocial        String?
  inscricaoEstadual  String?
  endereco           String?
  municipio          String?
  uf                 String?
  cep                String?
  email              String?
  // Só dígitos com DDD (10 ou 11), sem o 55.
  whatsapp           String?
  contatoComercial   String?
  // Prazo de pagamento combinado, em dias (0 a 180). Só GUARDADO: nenhuma conta, vencimento ou despesa nasce dele. Nulo = não informado.
  prazoPagamentoDias Int?
  // "Compras sem nota fiscal" (feira, atacarejo): dispensa CNPJ, razão social e e-mail; NUNCA casa com documento fiscal.
  semNotaFiscal      Boolean @default(false)
  // COMPLETO: passou pelo formulário com os obrigatórios. A_COMPLETAR: nasceu do sistema (migração dos antigos e, na F.1b, o
  // emitente desconhecido de uma nota), recebe notas, mas só se edita completando.
  situacaoCadastro   SituacaoCadastroFornecedor @default(A_COMPLETAR)
  // Idempotência de criar (a mesma do insumo): a chave do formulário (por pessoa) e a impressão do conteúdo.
  chaveEnvio         String?
  hashEnvio          String?

  insumosPadrao Insumo[]
  variantes     InsumoVariante[]
  notas         NotaEntrada[]

  @@unique([parceiroId, id])
  @@unique([parceiroId, nome])
  @@unique([parceiroId, chaveEnvio])
  @@index([parceiroId, documento])
}

enum SituacaoCadastroFornecedor {
  COMPLETO
  A_COMPLETAR
}

enum InsumoTipo {
  INGREDIENTE
  EMBALAGEM // embalagem é item de estoque (custo do delivery/iFood)
  PRE_PREPARO // intermediário produzido pela casa (tem FichaTecnica que o produz)
  MATERIAL // I.1b: material de limpeza e uso: comprado e estocado, mas não entra em ficha técnica como ingrediente
}

model Insumo {
  id                     String       @id @default(cuid())
  parceiroId             String
  // Restrict: parceiro com dado não some por acidente.
  parceiro               ParceiroFlow @relation(fields: [parceiroId], references: [id], onDelete: Restrict)
  nome                   String
  unidade                UnidadeBase
  // Embalagem de compra: "caixa de 5 kg por R$ 89,90" vira
  // conteudoMilesimos = 5000 e precoEmbalagemCentavos = 8990. O custo por
  // unidade base é derivado, nunca gravado — não tem como discordar da origem.
  conteudoMilesimos      Int
  precoEmbalagemCentavos Int
  criadoEm               DateTime     @default(now())
  atualizadoEm           DateTime     @updatedAt

  // 0.1 (fundação) — só acréscimos, todos com default ou opcionais.
  tipo                   InsumoTipo  @default(INGREDIENTE)
  // Frete rateado por embalagem de compra (1.1), em centavos.
  taxaEntregaCentavos    Int         @default(0)
  conservacao            Conservacao @default(SECO)
  // Validade por conservação (1.4), em MINUTOS (pista fria conta em horas).
  // Null = não se aplica àquela conservação.
  validadeSecoMin        Int?
  validadePistaFriaMin   Int?
  validadeRefrigeradoMin Int?
  validadeCongeladoMin   Int?
  estoqueMinimoMilesimos Int?
  fornecedorPadraoId     String?
  fornecedorPadrao       Fornecedor? @relation(fields: [parceiroId, fornecedorPadraoId], references: [parceiroId, id], onDelete: Restrict)
  ativo                  Boolean     @default(true)
  origem                 OrigemDado  @default(MANUAL)

  // I.1a — Categoria gerencial (natureza do insumo, para o CMV; NÃO é conservação nem setor). Nula no banco de
  // propósito: o insumo antigo continua legível até a classificação assistida; a regra (categoria obrigatória) é do
  // servidor, em todo insumo novo e em toda edição. FK composta: categoria de outro parceiro não entra.
  categoriaId            String?
  categoria              CategoriaInsumo? @relation(fields: [parceiroId, categoriaId], references: [parceiroId, id], onDelete: Restrict)
  // Como a categoria foi escolhida: MANUAL (a pessoa), SUGESTAO (a sugestão pelo nome, aceita) ou MIGRACAO (classificação assistida).
  classificadoPor        String?
  // Por que ficou em "Outros / a classificar" (ambíguo), em uma frase.
  classificacaoMotivo    String?
  // O lote da classificação assistida que pôs a categoria; nulo quando uma pessoa mexeu depois (só o intocado se reverte).
  classificacaoLote      String?
  classificadoEm         DateTime?
  // Idempotência de criar: a chave que o formulário mandou e a impressão do conteúdo. Mesma chave + mesmo conteúdo =
  // o mesmo insumo (sucesso); mesma chave + conteúdo diferente = recusa.
  chaveEnvio             String?
  hashEnvio              String?

  // I.1b — Marca de referência: a marca comercial/fabricante que a casa tem em mente para o insumo. Texto informativo e
  // opcional: não bloqueia compra nem cotação e não é fornecedor (a mesma marca é vendida por vários fornecedores).
  marcaReferencia        String?

  // I.1b — Quando uma PESSOA confirmou a conservação. Nulo no insumo antigo (o servidor assumia Seco quando nada vinha:
  // ninguém "escolheu"); preenchido ao cadastrar (a conservação é escolhida), ao salvar o formulário e no "Confirmar".
  // "Conservação a confirmar" = Seco, sem confirmação, em Proteína, Laticínios ou Hortifruti. Nada é reinterpretado.
  conservacaoConfirmadaEm DateTime?

  variantes         InsumoVariante[]
  fichaQueProduz    FichaTecnica?      @relation("FichaProduzInsumo")
  usosEmFichas      FichaItem[]
  usosComoEmbalagem ProdutoEmbalagem[]
  notaItens         NotaEntradaItem[]
  saldos            SaldoEstoque[]
  movimentos        MovimentoEstoque[]
  contagemItens     ContagemItem[]
  retratos          ContagemRetratoItem[]
  requisicaoItens   RequisicaoItem[]
  producoes         OrdemProducao[]
  etiquetas         Etiqueta[]

  // O nome repete entre parceiros (todo mundo tem "Cebola"), nunca dentro de um.
  @@unique([parceiroId, nome])
  @@unique([parceiroId, id])
  @@unique([parceiroId, chaveEnvio])
  @@index([parceiroId, criadoEm])
  @@index([parceiroId, tipo])
  @@index([parceiroId, categoriaId])
}

// I.1a — Categoria de insumo da REDE (do parceiro): a natureza do insumo para o CMV gerencial (Proteína, Hortifruti...).
// As dez padrão nascem por script idempotente (`erp:semear-categorias`, nunca pela migration) com `chave` estável; a casa
// cria, renomeia, reordena, desativa (com uso) e exclui (sem uso). "Outros / a classificar" é do sistema: não se
// renomeia, desativa nem exclui (gatilho). Desativar não apaga: o insumo que já está nela continua nela. A loja personaliza
// só a meta (I.2, `CategoriaNaLoja`), nunca a natureza do insumo.
model CategoriaInsumo {
  id           String       @id @default(cuid())
  parceiroId   String
  parceiro     ParceiroFlow @relation(fields: [parceiroId], references: [id], onDelete: Restrict)
  // PROTEINA, HORTIFRUTI, ... OUTROS: a identidade da padrão, que sobrevive ao renomear. Nula nas criadas pela casa.
  chave        String?
  nome         String
  ordem        Int          @default(0)
  sistema      Boolean      @default(false)
  ativa        Boolean      @default(true)
  criadaEm     DateTime     @default(now())
  desativadaEm DateTime?
  atualizadoEm DateTime     @updatedAt

  insumos Insumo[]
  usosNaLoja CategoriaNaLoja[]
  metasCmv MetaCmvCategoria[]
  retratos ContagemRetratoItem[]

  @@unique([parceiroId, id])
  @@unique([parceiroId, nome])
  @@unique([parceiroId, chave])
  @@index([parceiroId, ordem])
}

// I.2a — Retrato do estoque POR INSUMO de uma abertura ou de um fechamento concluídos: uma linha por insumo com saldo, com a
// categoria e o tipo DA HORA. Só inclusão (gatilho), gravado na MESMA transação que fecha a contagem; a soma dos valores é o
// `valorTotalCentavos` dela, ao centavo (o gatilho de `Contagem.retratoGravadoEm` confere). Valor nulo = insumo sem preço.
// É a base do CMV real por categoria (I.2b); contagem de antes da I.2 não tem e não é reconstruída.
model ContagemRetratoItem {
  id                  String           @id @default(cuid())
  parceiroId          String
  parceiro            ParceiroFlow     @relation(fields: [parceiroId], references: [id], onDelete: Restrict)
  contagemId          String
  contagem            Contagem         @relation(fields: [parceiroId, contagemId], references: [parceiroId, id], onDelete: Restrict)
  insumoId            String
  insumo              Insumo           @relation(fields: [parceiroId, insumoId], references: [parceiroId, id], onDelete: Restrict)
  categoriaIdNaHora   String?
  categoriaNaHora     CategoriaInsumo? @relation(fields: [parceiroId, categoriaIdNaHora], references: [parceiroId, id], onDelete: Restrict)
  tipoNaHora          InsumoTipo
  quantidadeMilesimos Int
  valorCentavos       Int?
  criadoEm            DateTime         @default(now())

  @@unique([parceiroId, id])
  @@unique([parceiroId, contagemId, insumoId])
  @@index([parceiroId, insumoId])
  @@index([parceiroId, categoriaIdNaHora])
}

// I.2a — Quais categorias a LOJA usa. Padrão: usa (herda a rede). Categoria não usada sai do formulário de metas e do painel
// daquela loja, salvo se tiver valor ("não usada nesta loja, mas teve R$ X"): custo nunca some. Não muda a natureza do insumo.
model CategoriaNaLoja {
  id                String          @id @default(cuid())
  parceiroId        String
  parceiro          ParceiroFlow    @relation(fields: [parceiroId], references: [id], onDelete: Restrict)
  lojaId            String
  loja              Loja            @relation(fields: [parceiroId, lojaId], references: [parceiroId, id], onDelete: Restrict)
  categoriaId       String
  categoria         CategoriaInsumo @relation(fields: [parceiroId, categoriaId], references: [parceiroId, id], onDelete: Restrict)
  usa               Boolean         @default(true)
  versao            Int             @default(1)
  atualizadoPorNome String          @default("")
  atualizadoEm      DateTime        @default(now()) @updatedAt

  @@unique([parceiroId, id])
  @@unique([parceiroId, lojaId, categoriaId])
}

// I.2a — Conjunto de metas por categoria, por escopo (rede = lojaId nulo; ou uma loja) e vigência (começo do período em curso).
// A loja SEGUE a rede (sem conjunto próprio, ou conjunto com `segueARede`) ou PERSONALIZA o conjunto inteiro. Só o conjunto mais
// novo do escopo muda (gatilho): o passado não é reescrito. A meta TOTAL do CMV é a `DreMeta` da linha `cmv` (uma fonte só).
model MetaCmvConjunto {
  id            String       @id @default(cuid())
  parceiroId    String
  parceiro      ParceiroFlow @relation(fields: [parceiroId], references: [id], onDelete: Restrict)
  lojaId        String?
  loja          Loja?        @relation(fields: [parceiroId, lojaId], references: [parceiroId, id], onDelete: Restrict)
  vigenteDesde  DateTime     @db.Date
  segueARede    Boolean      @default(false)
  // MODELO_32 quando o modelo ilustrativo de 32 % foi aplicado no formulário que gerou este conjunto; nulo caso contrário.
  aplicouModelo String?
  // I.2b: a meta TOTAL do CMV desta loja (pontos-base, 0 a 10.000), só na loja que personaliza; nulo = vale o total da rede (a meta do CMV do DRE).
  metaTotalBp   Int?
  versao        Int          @default(1)
  criadoPorNome String       @default("")
  criadoEm      DateTime     @default(now())
  atualizadoEm  DateTime     @default(now()) @updatedAt

  metas MetaCmvCategoria[]

  @@unique([parceiroId, id])
  // Um conjunto por escopo e vigência; no SQL é NULLS NOT DISTINCT (a rede tem loja nula e não pode repetir).
  @@unique([parceiroId, lojaId, vigenteDesde])
}

model MetaCmvCategoria {
  id           String          @id @default(cuid())
  parceiroId   String
  parceiro     ParceiroFlow    @relation(fields: [parceiroId], references: [id], onDelete: Restrict)
  conjuntoId   String
  conjunto     MetaCmvConjunto @relation(fields: [parceiroId, conjuntoId], references: [parceiroId, id], onDelete: Cascade)
  categoriaId  String
  // Restrict: a categoria com meta não se exclui, nem por SQL.
  categoria    CategoriaInsumo @relation(fields: [parceiroId, categoriaId], references: [parceiroId, id], onDelete: Restrict)
  // Pontos-base da receita bruta, 0 a 10.000.
  percentualBp Int

  @@unique([parceiroId, id])
  @@unique([parceiroId, conjuntoId, categoriaId])
  @@index([parceiroId, categoriaId])
}

// Outras embalagens de compra do mesmo insumo (fardo, caixa, marca B...).
// A do próprio Insumo continua sendo a padrão.
model InsumoVariante {
  id                     String       @id @default(cuid())
  parceiroId             String
  parceiro               ParceiroFlow @relation(fields: [parceiroId], references: [id], onDelete: Restrict)
  insumoId               String
  insumo                 Insumo       @relation(fields: [parceiroId, insumoId], references: [parceiroId, id], onDelete: Cascade)
  nome                   String
  conteudoMilesimos      Int
  precoEmbalagemCentavos Int
  taxaEntregaCentavos    Int          @default(0)
  fornecedorId           String?
  fornecedor             Fornecedor?  @relation(fields: [parceiroId, fornecedorId], references: [parceiroId, id], onDelete: Restrict)
  codigoBarras           String?
  ativo                  Boolean      @default(true)
  criadoEm               DateTime     @default(now())

  notaItens NotaEntradaItem[]

  @@unique([parceiroId, id])
  @@unique([parceiroId, insumoId, nome])
  @@index([parceiroId, codigoBarras])
}

enum NotaStatus {
  RASCUNHO // digitada/importada, ainda não conferida (sem uso na 1.5)
  LANCADA // conferida: vale para o custo (último preço). Movimento de estoque: só com o estoque da loja aberto (1.6, decisão 68)
  CANCELADA // não vale mais para nada; a chave da nota fica livre para relançar certa
}

// Nota de entrada (compra), por LOJA. Antes da abertura do estoque da loja ela
// não gera MovimentoEstoque (decisão 64); depois (1.6), nota lançada na loja
// aberta, com data a partir da abertura, gera ENTRADA_COMPRA na mesma
// transação; editar e cancelar estornam (decisão 68).
// Idempotência: fornecedor + número + série é único por parceiro entre as não
// canceladas (índice parcial escrito no SQL da migration 20261018010000).
model NotaEntrada {
  id                     String       @id @default(cuid())
  parceiroId             String
  parceiro               ParceiroFlow @relation(fields: [parceiroId], references: [id], onDelete: Restrict)
  lojaId                 String
  loja                   Loja         @relation(fields: [parceiroId, lojaId], references: [parceiroId, id], onDelete: Restrict)
  fornecedorId           String?
  fornecedor             Fornecedor?  @relation(fields: [parceiroId, fornecedorId], references: [parceiroId, id], onDelete: Restrict)
  fornecedorNomeSnapshot String?
  numero                 String?
  // Chave de acesso da NF-e (44 dígitos): impede lançar a mesma nota duas vezes.
  chaveAcesso            String?
  emitidaEm              DateTime?    @db.Date
  entradaEm              DateTime     @db.Date
  freteCentavos          Int          @default(0)
  descontoCentavos       Int          @default(0)
  totalCentavos          Int
  status                 NotaStatus   @default(RASCUNHO)
  origem                 OrigemDado   @default(MANUAL)
  origemRef              String?
  lancadaEm              DateTime?
  criadoEm               DateTime     @default(now())
  // 1.5: série da nota ('' = sem série), versão para editar, cancelamento.
  serie                  String       @default("")
  atualizadoEm           DateTime     @default(now()) @updatedAt
  canceladaEm            DateTime?
  motivoCancelamento     String?

  itens      NotaEntradaItem[]
  // 1.6: entradas e estornos no estoque da loja (só com o estoque aberto).
  movimentos MovimentoEstoque[]

  @@unique([parceiroId, id])
  @@unique([parceiroId, chaveAcesso])
  @@index([parceiroId, lojaId, entradaEm])
  @@index([parceiroId, fornecedorId, entradaEm])
  // 1.5: a última compra de cada insumo (data da nota, depois a hora do lançamento).
  @@index([parceiroId, status, entradaEm(sort: Desc), lancadaEm(sort: Desc)], map: "NotaEntrada_parceiroId_status_entradaEm_idx")
}

model NotaEntradaItem {
  id                  String          @id @default(cuid())
  parceiroId          String
  parceiro            ParceiroFlow    @relation(fields: [parceiroId], references: [id], onDelete: Restrict)
  notaId              String
  nota                NotaEntrada     @relation(fields: [parceiroId, notaId], references: [parceiroId, id], onDelete: Cascade)
  // Null enquanto a linha importada não foi casada com um insumo.
  insumoId            String?
  insumo              Insumo?         @relation(fields: [parceiroId, insumoId], references: [parceiroId, id], onDelete: Restrict)
  varianteId          String?
  variante            InsumoVariante? @relation(fields: [parceiroId, varianteId], references: [parceiroId, id], onDelete: Restrict)
  // Snapshot: como estava escrito na nota e como o insumo se chamava.
  descricaoNota       String
  insumoNomeSnapshot  String?
  unidadeSnapshot     UnidadeBase?
  // Quantidade de embalagens (milésimos: 2,5 caixas = 2500) × conteúdo de cada.
  embalagensMilesimos Int
  conteudoMilesimos   Int
  // Total na unidade base, já multiplicado: é o que entra no estoque.
  quantidadeMilesimos Int
  valorTotalCentavos  Int
  criadoEm            DateTime        @default(now())
  // 1.5: parte do frete da nota que cabe a este item (rateado pelo valor; a
  // soma dos itens bate com o frete da nota). Custo do item = (valor + frete) ÷ quantidade.
  freteRateadoCentavos Int            @default(0)
  // Snapshot da embalagem como foi comprada ("Caixa 5 kg", "Padrão 1 kg", "A granel (kg)").
  embalagemSnapshot   String?
  // Ordem da linha na nota (como foi digitada).
  ordem               Int             @default(0)

  movimentos MovimentoEstoque[]
  etiquetas  Etiqueta[]

  @@unique([parceiroId, id])
  @@index([parceiroId, notaId])
  @@index([parceiroId, insumoId])
}

// ------------------------------------------------- ERP · ficha técnica

enum FichaTipo {
  PRATO // vira item de venda
  PRE_PREPARO // subficha: produz um Insumo PRE_PREPARO (ou é usada direto)
}

model FichaTecnica {
  id                  String       @id @default(cuid())
  parceiroId          String
  parceiro            ParceiroFlow @relation(fields: [parceiroId], references: [id], onDelete: Restrict)
  nome                String
  tipo                FichaTipo
  // Quanto a receita rende, na unidade de rendimento (PRATO: 1 un = 1000).
  rendimentoMilesimos Int
  unidadeRendimento   UnidadeBase
  // PRE_PREPARO que vai para o estoque: o insumo que ele produz (1:1).
  insumoProduzidoId   String?
  insumoProduzido     Insumo?      @relation("FichaProduzInsumo", fields: [parceiroId, insumoProduzidoId], references: [parceiroId, id], onDelete: Restrict)
  modoPreparo         String?
  ativa               Boolean      @default(true)
  origem              OrigemDado   @default(MANUAL)
  criadoEm            DateTime     @default(now())
  atualizadoEm        DateTime     @updatedAt
  // 1.2: o que é, numa olhada (até 280), e a foto. Da foto, só o nome do
  // arquivo (32 hex aleatórios + extensão; CHECK no banco), o tipo conferido
  // pelos bytes e o tamanho. O arquivo mora em
  // <ERP_ARQUIVOS_DIR>/<parceiroId>/fichas/ e só é servido pelo portão.
  descricao           String?
  fotoArquivo         String?
  fotoMime            String?
  fotoBytes           Int?
  // 1.4: validade por conservação, o mesmo modelo do Insumo. `conservacao` é a
  // principal (null = validade não informada); cada coluna é a validade em
  // MINUTOS naquela conservação, null = o item não fica nela. CHECKs no banco:
  // 1 min a 730 dias; a principal tem validade; sem principal, nenhuma.
  conservacao            Conservacao?
  validadeSecoMin        Int?
  validadePistaFriaMin   Int?
  validadeRefrigeradoMin Int?
  validadeCongeladoMin   Int?

  itens          FichaItem[]     @relation("FichaItens")
  usadaComoSub   FichaItem[]     @relation("FichaSubficha")
  produtos       ProdutoVenda[]
  ordensProducao OrdemProducao[]
  requisicoes    Requisicao[]
  itensDeLista   ListaProducaoItem[]

  @@unique([parceiroId, id])
  @@unique([parceiroId, nome])
  @@unique([parceiroId, insumoProduzidoId])
  @@index([parceiroId, tipo])
}

// Linha da ficha: OU um insumo OU outra ficha (subficha) — CHECK no banco.
// Ciclo (A usa B que usa A) é barrado pela regra da 1.3, não pelo banco.
model FichaItem {
  id                     String        @id @default(cuid())
  parceiroId             String
  parceiro               ParceiroFlow  @relation(fields: [parceiroId], references: [id], onDelete: Restrict)
  fichaId                String
  ficha                  FichaTecnica  @relation("FichaItens", fields: [parceiroId, fichaId], references: [parceiroId, id], onDelete: Cascade)
  insumoId               String?
  insumo                 Insumo?       @relation(fields: [parceiroId, insumoId], references: [parceiroId, id], onDelete: Restrict)
  subfichaId             String?
  subficha               FichaTecnica? @relation("FichaSubficha", fields: [parceiroId, subfichaId], references: [parceiroId, id], onDelete: Restrict)
  // Quantidade LÍQUIDA usada, na unidade base do insumo / de rendimento da subficha.
  quantidadeMilesimos    Int
  // Fator de correção (bruto ÷ líquido), em milésimos: 1000 = sem perda.
  fatorCorrecaoMilesimos Int           @default(1000)
  ordem                  Int           @default(0)

  @@unique([parceiroId, id])
  @@index([parceiroId, fichaId])
  @@index([parceiroId, insumoId])
  @@index([parceiroId, subfichaId])
}

// ------------------------------------------------- ERP · venda e preço por canal

model ProdutoVenda {
  id            String       @id @default(cuid())
  parceiroId    String
  parceiro      ParceiroFlow @relation(fields: [parceiroId], references: [id], onDelete: Restrict)
  marcaId       String?
  marca         Marca?       @relation(fields: [parceiroId, marcaId], references: [parceiroId, id], onDelete: Restrict)
  fichaId       String
  ficha         FichaTecnica @relation(fields: [parceiroId, fichaId], references: [parceiroId, id], onDelete: Restrict)
  nome          String
  // Código no PDV/iFood, para casar importação e integração.
  codigoExterno String?
  ativo         Boolean      @default(true)
  origem        OrigemDado   @default(MANUAL)
  criadoEm      DateTime     @default(now())

  canais     ProdutoCanal[]
  embalagens ProdutoEmbalagem[]

  @@unique([parceiroId, id])
  // NULLS NOT DISTINCT (no SQL): sem marca, o nome também não repete.
  @@unique([parceiroId, marcaId, nome])
  @@index([parceiroId, fichaId])
  @@index([parceiroId, codigoExterno])
}

// Preço por canal (1.9/1.10). Preço sugerido = custo do canal + margem-alvo,
// calculado no servidor; `precoManualCentavos` sobrescreve (null = sugerido).
model ProdutoCanal {
  id                  String       @id @default(cuid())
  parceiroId          String
  parceiro            ParceiroFlow @relation(fields: [parceiroId], references: [id], onDelete: Restrict)
  produtoId           String
  produto             ProdutoVenda @relation(fields: [parceiroId, produtoId], references: [parceiroId, id], onDelete: Cascade)
  canal               CanalVenda
  precoManualCentavos Int?
  // Null = usa a margem-alvo padrão do canal (CanalConfig).
  margemAlvoBp        Int?
  ativo               Boolean      @default(true)
  atualizadoEm        DateTime     @updatedAt

  @@unique([parceiroId, id])
  @@unique([parceiroId, produtoId, canal])
}

// Camada de embalagem do custo por canal: o que vai junto no delivery/iFood.
model ProdutoEmbalagem {
  id                  String       @id @default(cuid())
  parceiroId          String
  parceiro            ParceiroFlow @relation(fields: [parceiroId], references: [id], onDelete: Restrict)
  produtoId           String
  produto             ProdutoVenda @relation(fields: [parceiroId, produtoId], references: [parceiroId, id], onDelete: Cascade)
  canal               CanalVenda
  insumoId            String
  insumo              Insumo       @relation(fields: [parceiroId, insumoId], references: [parceiroId, id], onDelete: Restrict)
  quantidadeMilesimos Int

  @@unique([parceiroId, id])
  @@unique([parceiroId, produtoId, canal, insumoId])
}

// Configuração do canal por parceiro: taxa do iFood (e de quem mais cobrar)
// e margem-alvo padrão.
model CanalConfig {
  id                 String       @id @default(cuid())
  parceiroId         String
  parceiro           ParceiroFlow @relation(fields: [parceiroId], references: [id], onDelete: Restrict)
  canal              CanalVenda
  // Comissão sobre o preço, em pontos-base (12% = 1200).
  taxaBp             Int          @default(0)
  // Taxa fixa por pedido (ex.: taxa de transação), em centavos. 1.9: não entra
  // no custo do PRATO (é do pedido: lucro por pedido); sem tela.
  taxaFixaCentavos   Int          @default(0)
  // 1.9: taxa de pagamento online sobre o preço, em pontos-base (3,2% = 320).
  // CHECK 0..10000 e comissão + pagamento < 10000. Ver decisão 81.
  taxaPagamentoBp    Int          @default(0)
  margemAlvoPadraoBp Int?
  ativo              Boolean      @default(true)
  atualizadoEm       DateTime     @updatedAt

  @@unique([parceiroId, id])
  @@unique([parceiroId, canal])
}

// ------------------------------------------------- ERP · estoque

// Saldo corrente por loja × insumo. É cache dos movimentos, atualizado na MESMA
// transação que grava o movimento. Custo médio = valor ÷ quantidade (derivado).
model SaldoEstoque {
  id                  String       @id @default(cuid())
  parceiroId          String
  parceiro            ParceiroFlow @relation(fields: [parceiroId], references: [id], onDelete: Restrict)
  lojaId              String
  loja                Loja         @relation(fields: [parceiroId, lojaId], references: [parceiroId, id], onDelete: Restrict)
  insumoId            String
  insumo              Insumo       @relation(fields: [parceiroId, insumoId], references: [parceiroId, id], onDelete: Restrict)
  // Pode ficar negativo (baixa antes da nota): é sinal de divergência, não erro.
  quantidadeMilesimos Int          @default(0)
  valorCentavos       Int          @default(0)
  // Trava otimista: update só com a versão lida.
  versao              Int          @default(0)
  atualizadoEm        DateTime     @updatedAt

  @@unique([parceiroId, id])
  @@unique([parceiroId, lojaId, insumoId])
}

enum MovimentoTipo {
  ABERTURA // 1ª contagem = saldo inicial (1.6)            (+)
  ENTRADA_COMPRA // nota lançada (1.5)                            (+)
  REQUISICAO // baixa pela requisição (1.8)                   (−)
  PRODUCAO_ENTRADA // lote produzido entra no estoque (3.1)         (+)
  PRODUCAO_CONSUMO // insumo consumido pela produção (3.1)          (−)
  AJUSTE // ajuste manual com motivo                      (±)
  CONTAGEM // acerto do saldo pela contagem (1.7)           (±)
  PERDA // descarte/vencido                              (−)
}

// Livro-razão do estoque: só se acrescenta; correção é outro movimento.
// Quantidade e valor COM SINAL (+ entra, − sai). Antes/depois do saldo
// gravados: todo ajuste mostra de quanto para quanto foi.
model MovimentoEstoque {
  id                   String           @id @default(cuid())
  parceiroId           String
  parceiro             ParceiroFlow     @relation(fields: [parceiroId], references: [id], onDelete: Restrict)
  lojaId               String
  loja                 Loja             @relation(fields: [parceiroId, lojaId], references: [parceiroId, id], onDelete: Restrict)
  insumoId             String
  insumo               Insumo           @relation(fields: [parceiroId, insumoId], references: [parceiroId, id], onDelete: Restrict)
  tipo                 MovimentoTipo
  quantidadeMilesimos  Int
  valorCentavos        Int
  saldoAntesMilesimos  Int
  saldoDepoisMilesimos Int
  // Snapshot do insumo no momento.
  insumoNomeSnapshot   String
  unidadeSnapshot      UnidadeBase
  motivo               String?
  ocorridoEm           DateTime         @default(now())
  criadoEm             DateTime         @default(now())
  origem               OrigemDado       @default(MANUAL)
  // Retry da tela/integração não duplica movimento.
  chaveIdempotencia    String?
  colaboradorId        String?
  colaborador          Colaborador?     @relation(fields: [parceiroId, colaboradorId], references: [parceiroId, id], onDelete: Restrict)
  // Documento que gerou o movimento (no máximo um, CHECK no banco).
  notaItemId           String?
  notaItem             NotaEntradaItem? @relation(fields: [parceiroId, notaItemId], references: [parceiroId, id], onDelete: Restrict)
  requisicaoItemId     String?
  requisicaoItem       RequisicaoItem?  @relation(fields: [parceiroId, requisicaoItemId], references: [parceiroId, id], onDelete: Restrict)
  contagemItemId       String?
  contagemItem         ContagemItem?    @relation(fields: [parceiroId, contagemItemId], references: [parceiroId, id], onDelete: Restrict)
  ordemProducaoId      String?
  ordemProducao        OrdemProducao?   @relation(fields: [parceiroId, ordemProducaoId], references: [parceiroId, id], onDelete: Restrict)
  // 1.6: a nota (cabeçalho, estável: editar troca os itens) que gerou a entrada.
  notaId               String?
  nota                 NotaEntrada?     @relation(fields: [parceiroId, notaId], references: [parceiroId, id], onDelete: Restrict)
  // 1.6: o movimento que este desfaz (espelho exato, conferido por trigger). Único.
  // NoAction (não Restrict): a limpeza administrativa apaga original e estorno no
  // mesmo DELETE (conferido no fim do comando); UPDATE no razão segue proibido.
  estornoDeId          String?
  estornoDe            MovimentoEstoque? @relation("EstornoDoMovimento", fields: [parceiroId, estornoDeId], references: [parceiroId, id], onDelete: NoAction)
  estorno              MovimentoEstoque? @relation("EstornoDoMovimento")

  @@unique([parceiroId, id])
  @@unique([parceiroId, chaveIdempotencia])
  @@unique([parceiroId, estornoDeId])
  @@index([parceiroId, notaId])
  @@index([parceiroId, lojaId, insumoId, ocorridoEm])
  @@index([parceiroId, lojaId, tipo, ocorridoEm])
  @@index([parceiroId, colaboradorId, ocorridoEm])
}

enum ContagemTipo {
  ABERTURA // 1ª contagem da loja: vira saldo inicial
  CICLICA // inventário cíclico do dia a dia
  FECHAMENTO // fecha o período: estoque final do CMV real
}

enum ContagemStatus {
  ABERTA
  FECHADA
  CANCELADA
}

// 1.7: como uma contagem FECHADA terminou (CHECK: FECHADA <=> desfecho).
enum ContagemDesfecho {
  APLICADA // o gerente conferiu e aplicou (ou a abertura concluída)
  APLICADA_SOZINHA // tudo contado e dentro da tolerância: fechou sozinha
  VENCIDA // passou do prazo sem aplicar: fechou sem mexer no estoque
}

model Contagem {
  id                 String           @id @default(cuid())
  parceiroId         String
  parceiro           ParceiroFlow     @relation(fields: [parceiroId], references: [id], onDelete: Restrict)
  lojaId             String
  loja               Loja             @relation(fields: [parceiroId, lojaId], references: [parceiroId, id], onDelete: Restrict)
  periodoId          String?
  periodo            PeriodoApuracao? @relation(fields: [parceiroId, periodoId], references: [parceiroId, id], onDelete: Restrict)
  tipo               ContagemTipo
  status             ContagemStatus   @default(ABERTA)
  // Data de referência do estoque contado.
  referenciaEm       DateTime         @db.Date
  // A contagem fecha sozinha neste horário (1.7), se ainda aberta.
  fechaAutomaticoEm  DateTime?
  fechadaEm          DateTime?
  // Snapshot do valor total contado no fechamento (soma dos itens).
  valorTotalCentavos Int?
  origem             OrigemDado       @default(MANUAL)
  criadoEm           DateTime         @default(now())
  // 1.6: sobe a cada número salvo (trava a contagem; é a "versão conferida" do
  // concluir). Quem começou e quem concluiu (snapshot do nome). Quantos itens
  // ficaram sem contar no fechamento (entraram com zero, confirmado).
  versao                  Int     @default(0)
  iniciadaPorNome         String?
  fechadaPorNome          String?
  naoContadosNoFechamento Int?
  // 1.7: nome do ciclo ("Refrigerado · vencidos") e como terminou.
  titulo                  String?
  desfecho                ContagemDesfecho?
  // 2.3: quantos insumos com saldo ficaram sem preço no retrato (abertura e fechamento), gravado no
  // mesmo UPDATE que fecha a contagem. Nulo = contagem de antes do registro ("não registrado"). CHECK >= 0.
  itensSemPreco           Int?
  // I.2a: quando o retrato POR INSUMO (`ContagemRetratoItem`) foi gravado, no mesmo UPDATE que fecha a abertura e o fechamento.
  // Nulo = contagem de antes da I.2 (ou cíclica/vencida): sem retrato por insumo, nunca reconstruído. CHECK e gatilho no SQL.
  retratoGravadoEm        DateTime?

  itens   ContagemItem[]
  retrato ContagemRetratoItem[]

  @@unique([parceiroId, id])
  @@index([parceiroId, lojaId, referenciaEm])
  @@index([parceiroId, periodoId])
}

model ContagemItem {
  id                    String       @id @default(cuid())
  parceiroId            String
  parceiro              ParceiroFlow @relation(fields: [parceiroId], references: [id], onDelete: Restrict)
  contagemId            String
  contagem              Contagem     @relation(fields: [parceiroId, contagemId], references: [parceiroId, id], onDelete: Cascade)
  insumoId              String
  insumo                Insumo       @relation(fields: [parceiroId, insumoId], references: [parceiroId, id], onDelete: Restrict)
  insumoNomeSnapshot    String
  unidadeSnapshot       UnidadeBase
  // Null = ainda não contado.
  contadoMilesimos      Int?
  // Snapshot do sistema na hora da contagem: a divergência é contado − sistema.
  saldoSistemaMilesimos Int
  valorSistemaCentavos  Int
  colaboradorId         String?
  colaborador           Colaborador? @relation(fields: [parceiroId, colaboradorId], references: [parceiroId, id], onDelete: Restrict)
  contadoEm             DateTime?
  // 1.6: lista e fatores congelados ao abrir a contagem; o digitado
  // (embalagens fechadas + solto, e a escala kg/g) separado do normalizado
  // (`contadoMilesimos`); versão do item (dois contadores); quem contou.
  versao                     Int          @default(0)
  conservacaoSnapshot        Conservacao?
  embalagemSnapshot          String?
  embalagemConteudoMilesimos Int?
  embalagensMilesimos        Int?
  soltoMilesimos             Int?
  escalaDigitada             String?
  contadoPorNome             String?

  movimentos MovimentoEstoque[]

  @@unique([parceiroId, id])
  @@unique([parceiroId, contagemId, insumoId])
  @@index([parceiroId, insumoId])
}

enum RequisicaoStatus {
  ABERTA // pedida: nada saiu ainda
  ATENDIDA // tudo saiu (ou o resto foi encerrado: corte visível)
  CANCELADA // só sem nada entregue, com motivo
  PARCIAL // 1.8: saiu parte; o resto ainda pode sair
}

// Requisição (1.8): o setor pede, o estoque entrega, a baixa sai daqui.
model Requisicao {
  id            String           @id @default(cuid())
  parceiroId    String
  parceiro      ParceiroFlow     @relation(fields: [parceiroId], references: [id], onDelete: Restrict)
  lojaId        String
  loja          Loja             @relation(fields: [parceiroId, lojaId], references: [parceiroId, id], onDelete: Restrict)
  status        RequisicaoStatus @default(ABERTA)
  // Setor de destino em texto livre até a 0.4 trazer o cadastro de setores.
  setor         String?
  solicitanteId String?
  solicitante   Colaborador?     @relation("RequisicaoSolicitante", fields: [parceiroId, solicitanteId], references: [parceiroId, id], onDelete: Restrict)
  atendenteId   String?
  atendente     Colaborador?     @relation("RequisicaoAtendente", fields: [parceiroId, atendenteId], references: [parceiroId, id], onDelete: Restrict)
  observacao    String?
  solicitadaEm  DateTime         @default(now())
  atendidaEm    DateTime?

  // 1.8: número por loja (#12; único na loja, dado sob a trava da loja),
  // versão (atender só na versão lida: duas entregas da mesma tela não baixam
  // duas vezes), para quando (dia, Rio), quem pediu/entregou/cancelou
  // (snapshot do nome: Colaborador ainda não liga à pessoa do login),
  // cancelamento com motivo, e a ficha técnica de onde a lista foi puxada
  // (snapshot do nome e de quanto se ia produzir). `setor` guarda a chave do
  // setor da 0.4 (CHECK no banco).
  numero                   Int?
  versao                   Int           @default(0)
  paraDia                  DateTime?     @db.Date
  pedidaPorNome            String?
  atendidaPorNome          String?
  canceladaPorNome         String?
  canceladaEm              DateTime?
  motivoCancelamento       String?
  fichaId                  String?
  ficha                    FichaTecnica? @relation(fields: [parceiroId, fichaId], references: [parceiroId, id], onDelete: Restrict)
  fichaNomeSnapshot        String?
  fichaQuantidadeMilesimos Int?

  itens         RequisicaoItem[]
  // 3.1: a ordem de produção que pediu esta requisição (no máximo uma; índice único na migration).
  ordemProducao OrdemProducao?

  @@unique([parceiroId, id])
  @@unique([parceiroId, lojaId, numero])
  @@index([parceiroId, lojaId, solicitadaEm])
  @@index([parceiroId, lojaId, status])
}

model RequisicaoItem {
  id                  String       @id @default(cuid())
  parceiroId          String
  parceiro            ParceiroFlow @relation(fields: [parceiroId], references: [id], onDelete: Restrict)
  requisicaoId        String
  requisicao          Requisicao   @relation(fields: [parceiroId, requisicaoId], references: [parceiroId, id], onDelete: Cascade)
  insumoId            String
  insumo              Insumo       @relation(fields: [parceiroId, insumoId], references: [parceiroId, id], onDelete: Restrict)
  insumoNomeSnapshot  String
  unidadeSnapshot     UnidadeBase
  solicitadoMilesimos Int
  // Null até atender; pode ser menor que o pedido (corte visível).
  atendidoMilesimos   Int?
  // 1.8: o que voltou (devolução por estorno; `atendido` é o líquido) e a ordem da lista.
  devolvidoMilesimos  Int          @default(0)
  ordem               Int          @default(0)

  movimentos MovimentoEstoque[]

  @@unique([parceiroId, id])
  @@unique([parceiroId, requisicaoId, insumoId])
  @@index([parceiroId, insumoId])
}

// ------------------------------------------------- ERP · produção

enum ProducaoStatus {
  PLANEJADA
  EM_EXECUCAO
  CONCLUIDA
  CANCELADA
}

// Ordem de produção = lote (3.1/3.3; a 3.3 acrescenta quem pegou e desde quando). A lista do dia (3.2) ganhou tabela própria
// (`ListaProducao`, decisão 218): o gerente define o que produzir ANTES de virar
// lote; cada linha que vira lote aponta a ordem (`ListaProducaoItem.ordemProducaoId`).
model OrdemProducao {
  id                      String         @id @default(cuid())
  parceiroId              String
  parceiro                ParceiroFlow   @relation(fields: [parceiroId], references: [id], onDelete: Restrict)
  lojaId                  String
  loja                    Loja           @relation(fields: [parceiroId, lojaId], references: [parceiroId, id], onDelete: Restrict)
  fichaId                 String
  ficha                   FichaTecnica   @relation(fields: [parceiroId, fichaId], references: [parceiroId, id], onDelete: Restrict)
  insumoProduzidoId       String?
  insumoProduzido         Insumo?        @relation(fields: [parceiroId, insumoProduzidoId], references: [parceiroId, id], onDelete: Restrict)
  // Código do lote impresso na etiqueta; único no parceiro.
  codigoLote              String
  status                  ProducaoStatus @default(PLANEJADA)
  dataPlanejada           DateTime       @db.Date
  planejadoMilesimos      Int
  produzidoMilesimos      Int?
  // Snapshot do custo do lote no fechamento (soma dos consumos).
  custoTotalCentavos      Int?
  fichaNomeSnapshot       String
  responsavelId           String?
  responsavel             Colaborador?   @relation(fields: [parceiroId, responsavelId], references: [parceiroId, id], onDelete: Restrict)
  responsavelNomeSnapshot String?
  // Insumos baixam pela requisição (3.1).
  requisicaoId            String?
  requisicao              Requisicao?    @relation(fields: [parceiroId, requisicaoId], references: [parceiroId, id], onDelete: Restrict)
  iniciadaEm              DateTime?
  concluidaEm             DateTime?
  observacao              String?
  criadoEm                DateTime       @default(now())

  // 3.1: produzir o pré-preparo pela ficha. A ordem CRIA a requisição dela na mesma transação (a baixa é a
  // entrega dessa requisição); concluir exige a requisição atendida, grava UM PRODUCAO_ENTRADA no insumo
  // produzido da mesma loja e fecha o custo do lote (baixas reais ÷ produzido, fração exata, nunca gravada).
  // Versão (concluir duas vezes = uma entrada), unidade e nomes de quem fez (texto: credencial fora do tenant),
  // cancelamento com motivo (CANCELADA com concluidaEm = estornada), motivo da diferença de rendimento,
  // quantos insumos da baixa ficaram sem preço, a conservação escolhida na conclusão e a validade que ela deu.
  versao                  Int            @default(0)
  unidadeSnapshot         UnidadeBase?
  chaveIdempotencia       String?
  planejadaPorNome        String?
  iniciadaPorNome         String?
  concluidaPorNome        String?
  canceladaPorNome        String?
  canceladaEm             DateTime?
  motivoCancelamento      String?
  motivoRendimento        String?
  insumosSemPreco         Int?
  conservacaoSnapshot     Conservacao?
  validadeMinSnapshot     Int?
  validadeEm              DateTime?
  responsavelUsuarioId    String?
  // 3.3: a cozinha PEGA o lote (pegar = começar): quem está fazendo vai em `responsavelUsuarioId` (a pessoa do login, texto
  // sem FK: a credencial mora fora do tenant) e `responsavelNomeSnapshot`, e desde quando aqui. Soltar zera os três; a
  // gerência passa para outra pessoa (a hora recomeça). Nulo com responsável = lote concluído sem pegar (3.1): quem
  // concluiu fica como quem fez, sem hora de início. `responsavelId` (Colaborador) fica para quem não tem login.
  responsavelDesde        DateTime?

  movimentos MovimentoEstoque[]
  etiquetas  Etiqueta[]
  // 3.2: a linha da lista do dia que virou este lote (no máximo uma).
  itemDaLista ListaProducaoItem?

  @@unique([parceiroId, id])
  @@unique([parceiroId, codigoLote])
  @@unique([parceiroId, requisicaoId])
  @@unique([parceiroId, chaveIdempotencia])
  @@index([parceiroId, lojaId, dataPlanejada])
  @@index([parceiroId, lojaId, status])
  @@index([parceiroId, responsavelId, concluidaEm])
  // 3.3: o histórico e os indicadores da produção leem os lotes encerrados da loja num período.
  @@index([parceiroId, lojaId, concluidaEm])
  @@index([parceiroId, lojaId, canceladaEm])
}

// 3.2: a lista do dia — o que a LOJA vai produzir num DIA, definido por quem tem
// "definir a lista do dia" (o gerente). Uma por loja e dia (índice único: dois
// cliques ou duas abas caem na mesma). Versão lida em toda escrita. Cruza com o
// saldo do estoque na leitura (vai usar / tem / comprar): nada disso é gravado.
// Não mexe no estoque: quem baixa é a requisição de cada lote (3.1).
model ListaProducao {
  id                String       @id @default(cuid())
  parceiroId        String
  parceiro          ParceiroFlow @relation(fields: [parceiroId], references: [id], onDelete: Restrict)
  lojaId            String
  loja              Loja         @relation(fields: [parceiroId, lojaId], references: [parceiroId, id], onDelete: Restrict)
  dia               DateTime     @db.Date
  versao            Int          @default(0)
  criadaEm          DateTime     @default(now())
  criadaPorNome     String
  atualizadaEm      DateTime     @default(now())
  atualizadaPorNome String

  itens ListaProducaoItem[]

  @@unique([parceiroId, id])
  @@unique([parceiroId, lojaId, dia])
}

// Linha da lista: um pré-preparo e quanto produzir (na unidade do rendimento da
// ficha, retrato do nome e da unidade). Vira lote pela regra da 3.1
// (`planejarProducao`): a linha guarda a ordem (única: uma linha, um lote).
// Linha com lote cancelado volta a ser só "na lista" (pode virar outro lote).
model ListaProducaoItem {
  id                  String         @id @default(cuid())
  parceiroId          String
  parceiro            ParceiroFlow   @relation(fields: [parceiroId], references: [id], onDelete: Restrict)
  listaId             String
  lista               ListaProducao  @relation(fields: [parceiroId, listaId], references: [parceiroId, id], onDelete: Cascade)
  fichaId             String
  ficha               FichaTecnica   @relation(fields: [parceiroId, fichaId], references: [parceiroId, id], onDelete: Restrict)
  fichaNomeSnapshot   String
  unidadeSnapshot     UnidadeBase
  quantidadeMilesimos Int
  ordem               Int            @default(0)
  ordemProducaoId     String?
  ordemProducao       OrdemProducao? @relation(fields: [parceiroId, ordemProducaoId], references: [parceiroId, id], onDelete: Restrict)
  criadoEm            DateTime       @default(now())

  @@unique([parceiroId, id])
  @@unique([parceiroId, ordemProducaoId])
  @@index([parceiroId, listaId])
  @@index([parceiroId, fichaId])
}

enum EtiquetaFormato {
  E60X40
  E60X60
}

// Etiqueta impressa (3.4): rastreio de lote/validade com snapshot. Vem de um
// lote produzido OU de um item de nota (lote do fornecedor) OU de um insumo aberto.
model Etiqueta {
  id                      String           @id @default(cuid())
  parceiroId              String
  parceiro                ParceiroFlow     @relation(fields: [parceiroId], references: [id], onDelete: Restrict)
  lojaId                  String
  loja                    Loja             @relation(fields: [parceiroId, lojaId], references: [parceiroId, id], onDelete: Restrict)
  // Código lido no leitor (vai no ZPL); único no parceiro.
  codigo                  String
  insumoId                String?
  insumo                  Insumo?          @relation(fields: [parceiroId, insumoId], references: [parceiroId, id], onDelete: Restrict)
  ordemProducaoId         String?
  ordemProducao           OrdemProducao?   @relation(fields: [parceiroId, ordemProducaoId], references: [parceiroId, id], onDelete: Restrict)
  notaItemId              String?
  notaItem                NotaEntradaItem? @relation(fields: [parceiroId, notaItemId], references: [parceiroId, id], onDelete: Restrict)
  // Snapshot.
  nomeSnapshot            String
  unidadeSnapshot         UnidadeBase?
  quantidadeMilesimos     Int?
  conservacao             Conservacao
  loteFornecedor          String?
  fabricadoEm             DateTime?
  abertoEm                DateTime?
  validadeEm              DateTime
  responsavelId           String?
  responsavel             Colaborador?     @relation(fields: [parceiroId, responsavelId], references: [parceiroId, id], onDelete: Restrict)
  responsavelNomeSnapshot String?
  formato                 EtiquetaFormato
  impressaEm              DateTime         @default(now())

  @@unique([parceiroId, id])
  @@unique([parceiroId, codigo])
  @@index([parceiroId, lojaId, validadeEm])
  @@index([parceiroId, ordemProducaoId])
}

// ------------------------------------------------- ERP · faturamento e DRE

// Faturamento por canal por dia (2.1). Cada lançamento tem chave de
// idempotência ÚNICA no parceiro: reprocessar integração ou reenviar
// planilha não duplica venda. O humano (MANUAL ou IMPORTACAO) divide UMA linha
// por loja × canal × dia, com chave determinística
// (manual:<loja>:<marca ou ->:<canal>:<data>), então redigitar ou reimportar é
// correção, não soma; na 2.1 a marca fica nula. A integração usa outro espaço
// de chave (<fonte>:<tipo>:<idExterno>) e, na leitura, vence a digitação
// (decisão 125). Valor = venda de produtos de pedidos concluídos, líquida do
// desconto pago pela casa (decisão 124). Ticket médio é derivado, nunca gravado.
// CHECKs e o índice parcial do grão humano estão só no SQL da migration
// 20261025000000_erp_faturamento (o Prisma não descreve).
model FaturamentoLancamento {
  id                String       @id @default(cuid())
  parceiroId        String
  parceiro          ParceiroFlow @relation(fields: [parceiroId], references: [id], onDelete: Restrict)
  lojaId            String
  loja              Loja         @relation(fields: [parceiroId, lojaId], references: [parceiroId, id], onDelete: Restrict)
  marcaId           String?
  marca             Marca?       @relation(fields: [parceiroId, marcaId], references: [parceiroId, id], onDelete: Restrict)
  canal             CanalVenda
  data              DateTime     @db.Date
  valorCentavos     Int
  pedidos           Int
  // ATENDIMENTOS no dia (o que o canal reporta), não clientes únicos: a
  // mesma pessoa em dois dias conta duas vezes. Ticket médio = valor ÷ pedidos.
  clientes          Int
  origem            OrigemDado
  chaveIdempotencia String
  // Id externo (pedido/relatório iFood, nome do arquivo importado).
  origemRef         String?
  // 2.1: quem lançou ou corrigiu por último (nome na hora, como o histórico).
  atualizadoPorNome String       @default("")
  criadoEm          DateTime     @default(now())
  atualizadoEm      DateTime     @updatedAt

  @@unique([parceiroId, id])
  @@unique([parceiroId, chaveIdempotencia])
  @@index([parceiroId, lojaId, data])
  @@index([parceiroId, canal, data])
}

enum DreGrupo {
  RECEITA // faturamento (calculada)
  DEDUCAO // taxas de canal, impostos sobre venda
  CMV // calculada (compras ou inicial+compras−final)
  DESPESA_VARIAVEL
  PESSOAL
  OCUPACAO
  ADMINISTRATIVA
  MARKETING
  FINANCEIRA
  OUTRAS
  // 2.2a: água, luz, gás e internet têm grupo próprio; RESULTADO são as linhas
  // calculadas de subtotal e de resultado (receita líquida, margem de
  // contribuição, resultado operacional e do período, mais o subtotal de cada grupo).
  UTILIDADES
  RESULTADO
}

enum DreSentido {
  MAIOR_MELHOR // receita, margem
  MENOR_MELHOR // CMV, despesas, taxas
}

// Linhas/categorias do DRE do parceiro. `calculada` = vem do sistema
// (faturamento, CMV, taxas), não recebe despesa manual.
model DreLinha {
  id         String       @id @default(cuid())
  parceiroId String
  parceiro   ParceiroFlow @relation(fields: [parceiroId], references: [id], onDelete: Restrict)
  nome       String
  grupo      DreGrupo
  ordem      Int          @default(0)
  calculada  Boolean      @default(false)
  // Para que lado o desvio vs meta é bom: receita maior é melhor; CMV e
  // despesa, menor. O farol lê o desvio já com esse sinal.
  sentido    DreSentido   @default(MENOR_MELHOR)
  ativa      Boolean      @default(true)
  criadoEm   DateTime     @default(now())
  // 2.2a: código estável do plano padrão (`aluguel`, `grupo:PESSOAL`): é por ele
  // que o plano se completa sozinho e que a linha renomeada continua sendo a
  // mesma. Linha criada pela casa não tem código. Calculada sempre tem (CHECK).
  codigo     String?
  atualizadoEm DateTime    @default(now()) @updatedAt

  metas       DreMeta[]
  despesas    Despesa[]
  farolFaixas FarolFaixa[]

  @@unique([parceiroId, id])
  @@unique([parceiroId, nome])
  @@unique([parceiroId, codigo])
}

// Meta % por linha (sobre o faturamento), por parceiro, com vigência: mudar a
// meta não reescreve o realizado vs meta dos períodos passados. Canal null =
// meta da rede (todos os canais); com canal, vale só para aquele canal.
// Unique com NULLS NOT DISTINCT (no SQL): só uma meta "de rede" por vigência.
model DreMeta {
  id           String       @id @default(cuid())
  parceiroId   String
  parceiro     ParceiroFlow @relation(fields: [parceiroId], references: [id], onDelete: Restrict)
  linhaId      String
  linha        DreLinha     @relation(fields: [parceiroId, linhaId], references: [parceiroId, id], onDelete: Cascade)
  canal        CanalVenda?
  percentualBp Int
  vigenteDesde DateTime     @db.Date
  criadoEm     DateTime     @default(now())
  // 2.2b: "apagar a meta" é uma linha com `semMeta` (percentualBp = 0, CHECK): a meta
  // anterior não volta sozinha. `canal` fica nulo (meta por canal é da 2.4).
  semMeta        Boolean    @default(false)
  criadoPorNome  String     @default("")
  atualizadoEm   DateTime   @default(now()) @updatedAt

  @@unique([parceiroId, id])
  @@unique([parceiroId, linhaId, canal, vigenteDesde])
}

// Despesa manual (ou importada) numa linha do DRE. Loja null = despesa da rede;
// canal null = rateada entre canais (canal preenchido = despesa só daquele canal).
model Despesa {
  id                String       @id @default(cuid())
  parceiroId        String
  parceiro          ParceiroFlow @relation(fields: [parceiroId], references: [id], onDelete: Restrict)
  lojaId            String?
  loja              Loja?        @relation(fields: [parceiroId, lojaId], references: [parceiroId, id], onDelete: Restrict)
  linhaId           String
  linha             DreLinha     @relation(fields: [parceiroId, linhaId], references: [parceiroId, id], onDelete: Restrict)
  descricao         String
  // Dia de competência (entra no período que contém essa data).
  competencia       DateTime     @db.Date
  canal             CanalVenda?
  valorCentavos     Int
  origem            OrigemDado   @default(MANUAL)
  origemRef         String?
  // Obrigatória na importação/integração (CHECK): reimportar a planilha não
  // duplica despesa. Digitada à mão pode ficar nula.
  chaveIdempotencia String?
  criadoEm          DateTime     @default(now())
  atualizadoEm      DateTime     @updatedAt
  // 2.2a: a competência é um intervalo (dia, mês inteiro ou até 366 dias):
  // `competencia` é o primeiro dia e `competenciaFim` o último (nulo = um dia só,
  // como as linhas anteriores à 2.2a). O DRE apropria o valor dia a dia.
  competenciaFim    DateTime?    @db.Date
  // Repete todo mês (só vale para competência de mês inteiro): "Lançar as do mês
  // passado" parte daqui. A filha aponta a de origem (`repeteDeId`), única: a
  // mesma não se lança duas vezes.
  recorrente        Boolean      @default(false)
  repeteDeId        String?
  // NoAction (não Restrict): a limpeza administrativa apaga a de origem e a filha no mesmo DELETE.
  repeteDe          Despesa?     @relation("DespesaRepetida", fields: [parceiroId, repeteDeId], references: [parceiroId, id], onDelete: NoAction)
  repetidaPor       Despesa?     @relation("DespesaRepetida")
  // Contas a pagar mínimas: quando vence e quando foi paga. Não mudam o DRE.
  vencimento        DateTime?    @db.Date
  pagaEm            DateTime?    @db.Date
  atualizadoPorNome String       @default("")

  @@unique([parceiroId, id])
  @@unique([parceiroId, chaveIdempotencia])
  @@unique([parceiroId, repeteDeId])
  @@index([parceiroId, competencia])
  @@index([parceiroId, lojaId, competencia])
  @@index([parceiroId, linhaId, competencia])
  @@index([parceiroId, vencimento])
}

enum PeriodoStatus {
  ABERTO
  FECHADO
}

// Período de apuração do DRE/CMV (datas inclusivas). Fechado = números travados.
// 2.2a: períodos nunca se sobrepõem (gatilho `PeriodoApuracao_sem_sobreposicao`,
// só no SQL) e só nascem por `registrarPeriodo` (periodos.ts), sob a trava.
model PeriodoApuracao {
  id         String        @id @default(cuid())
  parceiroId String
  parceiro   ParceiroFlow  @relation(fields: [parceiroId], references: [id], onDelete: Restrict)
  nome       String
  inicio     DateTime      @db.Date
  fim        DateTime      @db.Date
  status     PeriodoStatus @default(ABERTO)
  fechadoEm  DateTime?
  criadoEm   DateTime      @default(now())
  // 2.2b: quem fechou (nome da época). FECHADO exige `fechadoEm` (CHECK) e uma
  // fotografia vigente (gatilho adiado, só no SQL); depois de fechado, início, fim
  // e nome não mudam (gatilho).
  fechadoPorNome String?

  contagens   Contagem[]
  fotografias DreFotografia[]

  @@unique([parceiroId, id])
  @@unique([parceiroId, inicio, fim])
}

// A fotografia do fechamento do período (2.2b, decisão 153): o DRE como saiu de
// `montarDre`, com a taxa do iFood, as metas e o plano DAQUELE momento. Imutável (gatilhos
// no SQL): só `substituidaEm/reabertaPorNome/motivoReabertura` mudam, uma vez, quando o
// nível 1 reabre. Fechar de novo grava a versão seguinte. O período só fica FECHADO com
// uma fotografia vigente (gatilho adiado). `entrada` (receita loja×canal, despesa
// apropriada loja×linha, plano) é a base da conta e nunca vai para uma tela de loja.
model DreFotografia {
  id                String          @id @default(cuid())
  parceiroId        String
  parceiro          ParceiroFlow    @relation(fields: [parceiroId], references: [id], onDelete: Restrict)
  periodoId         String
  periodo           PeriodoApuracao @relation(fields: [parceiroId, periodoId], references: [parceiroId, id], onDelete: Restrict)
  versao            Int
  inicio            DateTime        @db.Date
  fim               DateTime        @db.Date
  nomeDoPeriodo     String
  criadoEm          DateTime        @default(now())
  // A transação que a gravou (valor do banco): as linhas só entram na mesma transação.
  criadaNaTransacao BigInt          @default(dbgenerated("txid_current()"))
  fechadoPorNome    String
  taxaComissaoBp    Int?
  taxaPagamentoBp   Int?
  // 1 = sem CMV (2.2b); 2 = com o CMV de compra e o real (2.3); 3 = com o ano passado e a versão do farol (2.4).
  versaoDaConta     Int             @default(1)
  entrada           Json
  ressalvas         Json            @default("[]")
  justificativa     String?
  substituidaEm     DateTime?
  reabertaPorNome   String?
  motivoReabertura  String?

  linhas DreFotografiaLinha[]

  // Uma fotografia VIGENTE por período: índice único parcial, só no SQL.
  @@unique([parceiroId, id])
  @@unique([parceiroId, periodoId, versao])
}

// Uma linha do DRE fotografado: `lojaId` nulo é a rede; senão, a loja (nome da época em
// `lojaNome`). Só inclusão, na transação da fotografia (gatilhos). Valor em BigInt.
model DreFotografiaLinha {
  id            String        @id @default(cuid())
  parceiroId    String
  parceiro      ParceiroFlow  @relation(fields: [parceiroId], references: [id], onDelete: Restrict)
  fotografiaId  String
  fotografia    DreFotografia @relation(fields: [parceiroId, fotografiaId], references: [parceiroId, id], onDelete: Restrict)
  lojaId        String?
  loja          Loja?         @relation(fields: [parceiroId, lojaId], references: [parceiroId, id], onDelete: Restrict)
  lojaNome      String?
  ordem         Int
  chave         String
  codigo        String?
  linhaId       String?
  nome          String
  grupo         DreGrupo
  tipo          String
  nivel         Int
  sentido       DreSentido
  valorCentavos BigInt?
  percentualBp  Int?
  metaBp        Int?
  semContar     String[]
  nota          String?
  oculta        Boolean       @default(false)

  // (fotografiaId, lojaId, chave) é único com NULLS NOT DISTINCT: só no SQL.
  @@unique([parceiroId, id])
  @@unique([parceiroId, fotografiaId, lojaId, chave])
  @@index([parceiroId, fotografiaId])
}

// A regra do período do parceiro, versionada (2.2a, decisão 144): mensal,
// quinzenal ou semanal, com o dia em que começa. É a ÚNICA fonte do período do
// DRE e da contagem. Só se inclui (o gatilho recusa UPDATE; só a regra futura
// pendente se apaga, para ser substituída): mudar a regra nunca reescreve o
// passado, vale do dia seguinte ao fim do período atual. Sem nenhuma linha, vale
// o padrão do código (mensal, dia 1). A primeira linha de cada parceiro foi
// copiada de `ParceiroFlow.periodoTipo/periodoDiaInicio`, que deixaram de ser lidos.
model RegraDoPeriodo {
  id             String       @id @default(cuid())
  parceiroId     String
  parceiro       ParceiroFlow @relation(fields: [parceiroId], references: [id], onDelete: Restrict)
  vigenteDesde   DateTime     @db.Date
  tipo           PeriodoTipo
  // Mensal e quinzenal: dia do mês (1 a 28). Semanal: dia da semana (1 = segunda … 7 = domingo).
  diaInicio      Int
  criadoPorNome  String       @default("")
  criadoEm       DateTime     @default(now())

  @@unique([parceiroId, id])
  @@unique([parceiroId, vigenteDesde])
}

enum FarolCor {
  AZUL
  VERDE
  AMARELO
  LARANJA
  VERMELHO
}

// Farol (2.4): 5 faixas por linha do DRE com meta, por canal (null = visão da
// rede). Mede o DESVIO vs meta em pontos-base do faturamento, já com o sinal
// do `sentido` da linha: positivo = melhor que a meta. A cor vale a partir de
// `desvioMinimoBp`; lê-se da maior para a menor (VERMELHO costuma ser o piso).
// Unique com NULLS NOT DISTINCT (no SQL): canal null também não repete cor.
model FarolFaixa {
  id             String       @id @default(cuid())
  parceiroId     String
  parceiro       ParceiroFlow @relation(fields: [parceiroId], references: [id], onDelete: Restrict)
  linhaId        String
  linha          DreLinha     @relation(fields: [parceiroId, linhaId], references: [parceiroId, id], onDelete: Cascade)
  canal          CanalVenda?
  cor            FarolCor
  desvioMinimoBp Int

  @@unique([parceiroId, id])
  @@unique([parceiroId, linhaId, canal, cor])
}

// ------------------------------------------------- ERP · alterações visíveis

// Todo corte/ajuste/alteração de cadastro sensível (preço, ficha, meta,
// faturamento manual, despesa) grava antes/depois aqui. Só se acrescenta.
// Movimento de estoque já carrega saldo antes/depois por conta própria.
model HistoricoAlteracao {
  id            String       @id @default(cuid())
  parceiroId    String
  parceiro      ParceiroFlow @relation(fields: [parceiroId], references: [id], onDelete: Restrict)
  // Nome do modelo (ex.: "ProdutoCanal") e id da linha alterada.
  entidade      String
  entidadeId    String
  acao          String // CRIOU | ALTEROU | CANCELOU | CORTOU ...
  antes         Json?
  depois        Json?
  motivo        String?
  autorNome     String
  colaboradorId String?
  colaborador   Colaborador? @relation(fields: [parceiroId, colaboradorId], references: [parceiroId, id], onDelete: Restrict)
  ocorridoEm    DateTime     @default(now())

  @@index([parceiroId, entidade, entidadeId, ocorridoEm])
  @@index([parceiroId, ocorridoEm])
}

// ------------------------------------------------- ERP · acesso das pessoas (0.3)
//
// Login das pessoas dos parceiros (o Rodolfo continua no `User` do /rodolfo,
// que estas pessoas NUNCA alcançam). Estas tabelas ficam FORA do tenant de
// propósito: e-mail, senha, link de primeiro acesso, rosto e sessão são lidos
// ANTES de saber o parceiro (no login). Por isso não têm RLS nem GRANT para
// `erp_tenant`, e o acesso a elas é travado num módulo só:
// `src/lib/erp/credenciais.ts` (o prisma do portal recusa em runtime; o
// teste-guarda reprova uso fora dele). Nada aqui é dado de negócio do parceiro:
// o que muda no acesso vai para o `HistoricoAlteracao` DO parceiro.
//
// Uma pessoa pode estar em mais de um parceiro (consultor, sócio de rede): a
// identidade (e-mail, senha, rosto) é uma só e o vínculo é por parceiro, com
// status próprio. Perfis, setores e lojas de cada pessoa (0.4) ficam no vínculo.

enum AcessoStatus {
  ATIVO
  DESATIVADO
}

enum MetodoEntrada {
  SENHA
  ROSTO
}

enum DesafioTipo {
  REGISTRO
  ENTRADA
}

// A pessoa. E-mail único (sempre minúsculo, CHECK no banco). Senha só com
// bcrypt; nula até a pessoa usar o link de primeiro acesso.
model UsuarioErp {
  id              String    @id @default(cuid())
  email           String    @unique
  nome            String
  senhaHash       String?
  senhaDefinidaEm DateTime?
  ultimoLogin     DateTime?
  criadoEm        DateTime  @default(now())
  // 0.4: a senha atual foi criada por link gerado por quem cuida da equipe
  // DESTE parceiro (não pelo nível 1). Se a pessoa ganhar vínculo em outro
  // parceiro, essa senha não atravessa: é apagada e o nível 1 gera link novo
  // (decisão 41). Nulo = senha do nível 1 (ou ainda sem senha).
  senhaPorLinkDoParceiroId String?
  // 0.4 (Fiscal QA): quando a última revogação dos meios de entrar
  // (`revogarMeiosDeEntrada`: senha redefinida por link, ou senha de outro
  // parceiro apagada) tirou aparelhos com rosto. "Seu acesso" avisa que eles
  // saíram e que dá para ativar de novo; ativar um aparelho limpa.
  rostosRemovidosEm DateTime?
  // Sobe +1 a cada revogação dos meios de entrar. Login, entrada pelo rosto e
  // ativação de rosto leem a versão ANTES de conferir a credencial e só gravam
  // (sessão, aparelho) se ela ainda for a mesma, sob a trava da pessoa; e a
  // sessão guarda a versão em que nasceu (validarSessao recusa a de versão velha).
  versaoCredencial Int @default(0)

  acessos  AcessoParceiro[]
  convites ConviteAcesso[]
  passkeys PasskeyErp[]
  sessoes  SessaoErp[]
  desafios DesafioWebauthn[]
  // 0.6: o que a pessoa escolheu sobre as caixas de ajuda (1 linha, criada na 1ª escolha).
  preferencia PreferenciaErp?
}

// 0.6 · Preferência de ajuda contextual (decisão 112): por PESSOA, não por
// pessoa × parceiro (aprender o sistema é da pessoa; quem está em dois parceiros
// escolhe uma vez). FORA do tenant, como as outras credenciais: é lida junto
// com a sessão, antes de saber o parceiro. Sem `parceiroId`; o papel
// `erp_tenant` não tem GRANT; só `credenciais.ts` toca (o `prisma` do portal
// recusa). `fechadas` guarda "chave@versão" das caixas que a pessoa fechou
// (no máximo 300; CHECK no banco); `escolhidaEm` nulo = ainda não respondeu à
// pergunta da 1ª vez (sem resposta = dicas ligadas).
model PreferenciaErp {
  usuarioId    String    @id
  dicasLigadas Boolean   @default(true)
  escolhidaEm  DateTime?
  fechadas     String[]  @default([])
  atualizadoEm DateTime  @updatedAt

  usuario UsuarioErp @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
}

// Vínculo pessoa × parceiro. Desativar aqui derruba a sessão naquele parceiro
// na próxima requisição; o vínculo com outro parceiro segue.
//
// Permissões (0.4) moram no vínculo: a mesma pessoa pode ser dona em A e
// operadora em B. Perfil = um base (dono/gerente/operador, definidos em
// `src/lib/erp/permissoes.ts`) OU um perfil próprio do parceiro (CHECK: um dos
// dois). Ajuste por pessoa: extras e removidas. Lojas: rede inteira (vale para
// lojas futuras) OU a lista `lojaIds` (CHECK: um ou outro). `lojaIds` não tem
// FK de propósito (credencial nunca aponta para tabela de tenant): toda
// consulta de loja passa pelo portão do parceiro, então id de outro parceiro
// não acha nada. Setores são atributo da pessoa, não concedem nada.
model AcessoParceiro {
  id           String       @id @default(cuid())
  parceiroId   String
  parceiro     ParceiroFlow @relation(fields: [parceiroId], references: [id], onDelete: Restrict)
  usuarioId    String
  usuario      UsuarioErp   @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  status       AcessoStatus @default(ATIVO)
  criadoEm     DateTime     @default(now())
  atualizadoEm DateTime     @updatedAt

  perfilBase          PerfilBase?
  perfilId            String?
  // FK composta: o perfil é do MESMO parceiro do vínculo.
  perfil              PerfilAcesso? @relation(fields: [parceiroId, perfilId], references: [parceiroId, id], onDelete: Restrict)
  permissoesExtras    String[]      @default([])
  permissoesRemovidas String[]      @default([])
  setores             Setor[]       @default([])
  redeInteira         Boolean       @default(true)
  lojaIds             String[]      @default([])

  @@unique([parceiroId, usuarioId])
  @@index([usuarioId])
  @@index([parceiroId, perfilId])
}

// ------------------------------------------------- ERP · permissões (0.4)
//
// O catálogo de permissões e os perfis base (dono, gerente, operador) ficam em
// código (`src/lib/erp/permissoes.ts`), versionados. Aqui só o que o parceiro
// cria: perfil próprio, nascido de um base, com a lista COMPLETA de
// permissões (fotografia: permissão nova do catálogo não entra sozinha).
// Fora do tenant, junto das credenciais (é lido na validação da sessão).

enum PerfilBase {
  DONO
  GERENTE
  OPERADOR
}

// Setor da pessoa no parceiro (pode ter mais de um). Filtro e sugestão de
// perfil; não é permissão.
enum Setor {
  COZINHA
  SALAO
  ADMINISTRATIVO
  ESTOQUE
  CAIXA
  MOTOBOY
  FREELANCER
  COMPRAS
  MARKETING_CRM
  GERENCIA
}

model PerfilAcesso {
  id             String       @id @default(cuid())
  parceiroId     String
  parceiro       ParceiroFlow @relation(fields: [parceiroId], references: [id], onDelete: Restrict)
  nome           String
  // De qual perfil base foi copiado (para a tela; não concede nada).
  base           PerfilBase
  permissoes     String[]
  // Setores para os quais o perfil foi pensado (sugestão no cadastro da pessoa).
  setores        Setor[]      @default([])
  // Versão do catálogo quando o perfil foi salvo pela última vez.
  catalogoVersao Int
  criadoEm       DateTime     @default(now())
  atualizadoEm   DateTime     @updatedAt

  acessos AcessoParceiro[]

  @@unique([parceiroId, id])
  @@unique([parceiroId, nome])
}

// Link de primeiro acesso (ou de nova senha). Uso único, com validade. O token
// só existe no link que o Rodolfo copia: aqui fica o SHA-256 dele.
model ConviteAcesso {
  id         String       @id @default(cuid())
  usuarioId  String
  usuario    UsuarioErp   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  // De qual parceiro o link saiu (para o histórico).
  parceiroId String
  parceiro   ParceiroFlow @relation(fields: [parceiroId], references: [id], onDelete: Restrict)
  tokenHash  String       @unique
  expiraEm   DateTime
  usadoEm    DateTime?
  revogadoEm DateTime?
  criadoEm   DateTime     @default(now())
  // 0.4: gerado pelo nível 1 (true) ou por quem cuida da equipe do parceiro
  // (false). Link do parceiro só vale, NA HORA DO USO, se a pessoa não tiver
  // vínculo em nenhum outro parceiro (decisão 41).
  doNivel1   Boolean

  @@index([usuarioId, criadoEm])
}

// Entrada com o rosto (WebAuthn/passkey com verificação do usuário obrigatória).
// O servidor guarda SÓ a chave pública: imagem de rosto nunca sai do aparelho.
// `contador` é BigInt porque o aparelho manda um inteiro sem sinal de 32 bits
// (passa do `Int`); não é número de negócio.
model PasskeyErp {
  id           String     @id @default(cuid())
  usuarioId    String
  usuario      UsuarioErp @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  credencialId String     @unique
  chavePublica Bytes
  contador     BigInt     @default(0)
  transportes  String[]
  // Rótulo para a pessoa reconhecer o aparelho ("iPhone", "Android").
  aparelho     String
  sincronizada Boolean    @default(false)
  criadoEm     DateTime   @default(now())
  ultimoUsoEm  DateTime?

  @@index([usuarioId])
}

// Desafio do WebAuthn: aleatório, validade curta, uso único (apagado ao usar).
model DesafioWebauthn {
  id        String      @id @default(cuid())
  desafio   String      @unique
  tipo      DesafioTipo
  // Registro: de quem é. Entrada pelo rosto: nulo (o aparelho diz quem é).
  usuarioId String?
  usuario   UsuarioErp? @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  // Entrada pelo rosto: de que IP veio o pedido (teto de desafios abertos por IP).
  ip        String?
  expiraEm  DateTime
  criadoEm  DateTime    @default(now())

  @@index([expiraEm])
  @@index([ip, expiraEm])
  @@index([usuarioId, expiraEm])
}

// Sessão do ERP do parceiro: cookie próprio (não é a do /rodolfo). O cookie
// leva um token aleatório; aqui fica o SHA-256. O parceiro da sessão é a ÚNICA
// fonte do parceiro em /erp (nunca a URL). Nulo = ainda vai escolher.
model SessaoErp {
  id          String        @id @default(cuid())
  tokenHash   String        @unique
  usuarioId   String
  usuario     UsuarioErp    @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  parceiroId  String?
  parceiro    ParceiroFlow? @relation(fields: [parceiroId], references: [id], onDelete: Restrict)
  metodo      MetodoEntrada
  ip          String?
  criadoEm    DateTime      @default(now())
  expiraEm    DateTime
  encerradaEm DateTime?
  // `UsuarioErp.versaoCredencial` de quando a sessão nasceu: revogou, morreu.
  versaoCredencial Int @default(0)

  @@index([usuarioId])
}

// Toda tentativa de entrar (deu certo ou não): auditoria e base do limite de
// tentativas por e-mail E por IP (vale com várias réplicas do `web`).
model TentativaEntradaErp {
  id        String        @id @default(cuid())
  email     String?
  ip        String
  metodo    MetodoEntrada
  ok        Boolean
  // Para auditoria; a pessoa vê sempre a mesma mensagem.
  motivo    String
  usuarioId String?
  criadoEm  DateTime      @default(now())

  @@index([email, criadoEm])
  @@index([ip, criadoEm])
}

// ------------------------------------------------- ERP · onboarding (0.5)
//
// Pedido de acesso de um futuro Parceiro Flow: chega pela landing (ou o
// Rodolfo digita). FORA do tenant de propósito (decisão 91): o pedido nasce
// ANTES de existir parceiro, e spam nunca pode virar um ParceiroFlow (que não se
// apaga: o histórico tem FK Restrict). O Parceiro Flow só nasce na ativação,
// já ATIVO e com dono. Só `src/lib/erp/pedidos.ts` e `credenciais.ts` (a
// ativação) tocam estes modelos: o `prisma` do portal recusa em runtime, o
// teste-guarda reprova uso fora deles e o papel `erp_tenant` não tem GRANT.
// O vínculo com o parceiro se chama `parceiroCriadoId` (e não `parceiroId`) de
// propósito: `parceiroId` é a marca de tabela de tenant.

enum PedidoParceiroStatus {
  NOVO
  EM_CONVERSA
  ATIVADO
  RECUSADO
}

enum PedidoOrigem {
  LANDING
  MANUAL
}

enum TentativaPedidoResultado {
  ACEITO
  REENVIO
  ARMADILHA
  INVALIDO
  BLOQUEADO
}

model PedidoParceiro {
  id                  String               @id @default(cuid())
  origem              PedidoOrigem
  nomeGrupo           String
  responsavel         String
  // E.164 sem o "+" (5521999998888), como o Barney normaliza.
  whatsapp            String
  // Minúsculo (CHECK).
  email               String
  lojas               Int
  marcas              Int
  cidade              String
  // LGPD: o texto aceito e a versão dele. Obrigatório para quem veio da landing.
  consentimentoEm     DateTime?
  consentimentoVersao String?
  status              PedidoParceiroStatus @default(NOVO)
  // Quando entrou na etapa de agora: o atraso conta daqui.
  etapaDesde          DateTime             @default(now())
  // Condicional em toda decisão: duas pessoas no mesmo cartão não se atropelam.
  versao              Int                  @default(1)
  // Quantas vezes o mesmo contato mandou de novo (entra no mesmo cartão).
  reenvios            Int                  @default(0)
  motivoRecusa        String?
  // ATIVADO ⇔ parceiro criado (CHECK). Único: um pedido gera um parceiro só.
  parceiroCriadoId    String?              @unique
  parceiroCriado      ParceiroFlow?        @relation("PedidoParceiroCriado", fields: [parceiroCriadoId], references: [id], onDelete: Restrict)
  anonimizadoEm       DateTime?
  criadoEm            DateTime             @default(now())
  atualizadoEm        DateTime             @updatedAt

  eventos PedidoParceiroEvento[]

  @@index([status, etapaDesde])
  @@index([email])
  @@index([whatsapp])
  @@index([criadoEm])
}

// Só se acrescenta (trigger recusa UPDATE): etapa antes/depois, motivo e autor,
// sem copiar dado pessoal.
model PedidoParceiroEvento {
  id         String         @id @default(cuid())
  pedidoId   String
  pedido     PedidoParceiro @relation(fields: [pedidoId], references: [id], onDelete: Restrict)
  acao       String
  antes      Json?
  depois     Json?
  motivo     String?
  autorNome  String
  ocorridoEm DateTime       @default(now())

  @@index([pedidoId, ocorridoEm])
}

// Limite do formulário público (3/h e 10/dia por IP, teto global por dia).
// Tabela própria: pedido que falha não pode travar o login de quem divide o IP
// (`TentativaEntradaErp`).
model TentativaPedidoParceiro {
  id        String                   @id @default(cuid())
  ip        String
  resultado TentativaPedidoResultado
  criadoEm  DateTime                 @default(now())

  @@index([ip, criadoEm])
  @@index([criadoEm])
}
